+  // Share of the recent pings (older than 2 s, so their answers had time) without an answer.
+  static float Loss(const Peer& peer, OnlineClock::time_point now) {
+    int sent = 0, lost = 0;
+    for (const auto& ping : peer.pings) {
+      if (now - ping.sent < std::chrono::seconds(2)) continue;
+      ++sent;
+      if (!ping.answered) ++lost;
+    }
+    return sent ? float(lost) / float(sent) : 0.0f;
+  }
