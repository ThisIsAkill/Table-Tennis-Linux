+  // Ping/pong between room members, in DIRECT or DATA/RELAYED messages to port 0:
+  // u8 kind (1 ping, 2 pong), u32 sequence, u64 sender's clock in microseconds (echoed).
+  static constexpr uint16_t kControlPort = 0;
+  static uint64_t NowMicros() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                        OnlineClock::now().time_since_epoch())
+                        .count());
+  }
