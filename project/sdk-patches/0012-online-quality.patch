+  void DelayLoop() {
+    std::unique_lock<std::mutex> lock(delay_mutex_);
+    while (true) {
+      if (delayed_.empty()) {
+        delay_cv_.wait(lock);
+        continue;
+      }
+      const auto due = delayed_.front().due;
+      if (OnlineClock::now() < due) {
+        delay_cv_.wait_until(lock, due);
+        continue;
+      }
+      Delayed next = std::move(delayed_.front());
+      delayed_.pop_front();
+      const int fd = fd_;
+      lock.unlock();
+      if (fd >= 0) {
+        sendto(fd, reinterpret_cast<const char*>(next.data.data()), next.data.size(), 0,
+               reinterpret_cast<const sockaddr*>(&next.to), sizeof(next.to));
+      }
+      lock.lock();
+    }
+  }
 
