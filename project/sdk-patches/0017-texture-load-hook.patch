 namespace rex::system {
 
+// Called before the base level of a guest texture is uploaded to the GPU, so an embedding
+// application can replace its data in guest memory first (for example button icons). The data at
+// the physical address `guest_address` has the guest layout: tiled when `tiled` (see
+// texture_util::GetTiledOffset2D), big-endian. Called on the GPU command thread; may write the
+// `size` bytes there. Writes made later are seen by the normal memory watch and load the texture
+// again.
+struct TextureLoadHookInfo {
+  uint32_t guest_address;
+  uint32_t size;
+  uint32_t width;
+  uint32_t height;
+  uint32_t pitch_texels;  // row pitch of the base level, a multiple of 32
+  uint32_t format;  // xenos::TextureFormat
+  bool tiled;
+};
+using TextureLoadHook = void (*)(const TextureLoadHookInfo& info);
+
