+// The resolve and EDRAM clear shaders are prebuilt for the Xenos' 2048-tile EDRAM: they read the
+// base tile from ResolveEdramInfo bits 13-23 and wrap EDRAM addresses at 2048 tiles. With a larger
+// emulated EDRAM (xenos::kEdramTileCount), ResolveEdramInfo carries bit 11 of the base in bit 30,
+// and this rewrites a shader to read the 12-bit base and wrap at kEdramTileCount tiles:
+//   base = (info >> 13) & 2047            ->  base | ((info >> 13) >> 6) & 2048
+//   offset % (2048 * 1280)                ->  offset % (kEdramTileCount * 1280)
+//   offset % (scale * 2048)  [scaled]     ->  offset % (scale * kEdramTileCount)
+std::vector<uint32_t> AdaptEdramShader(const uint32_t* code, size_t size_bytes) {
+  std::vector<uint32_t> in(code, code + size_bytes / sizeof(uint32_t));
+  if (xenos::kEdramTileCount == 2048 || in.size() < 5) return in;
+  constexpr uint32_t kOpTypeInt = 21, kOpConstant = 43, kOpIMul = 132, kOpUMod = 137,
+                     kOpShiftRightLogical = 194, kOpBitwiseOr = 197, kOpBitwiseAnd = 199;
+  uint32_t uint_type = 0, const_13 = 0, const_2047 = 0, const_2048 = 0, const_edram = 0;
+  std::vector<uint32_t> shifted_by_13, edram_size_products;
+  for (size_t i = 5; i < in.size();) {
+    const uint32_t count = in[i] >> 16, op = in[i] & 0xFFFF;
+    if (!count || i + count > in.size()) return in;
+    if (op == kOpTypeInt && count == 4 && in[i + 2] == 32 && in[i + 3] == 0) uint_type = in[i + 1];
+    if (op == kOpConstant && count == 4 && uint_type && in[i + 1] == uint_type) {
+      const uint32_t id = in[i + 2], value = in[i + 3];
+      if (value == 13) const_13 = id;
+      if (value == 2047) const_2047 = id;
+      if (value == 2048) const_2048 = id;
+      if (value == 2048 * 1280) const_edram = id;
+    }
+    if (op == kOpShiftRightLogical && count == 5 && const_13 && in[i + 4] == const_13) {
+      shifted_by_13.push_back(in[i + 2]);
+    }
+    if (op == kOpIMul && count == 5 && const_2048 && (in[i + 3] == const_2048 || in[i + 4] == const_2048)) {
+      edram_size_products.push_back(in[i + 2]);
+    }
+    i += count;
+  }
+  if (!uint_type || !const_2047) return in;
+  uint32_t bound = in[3];
+  const uint32_t c6 = bound++, c2048 = bound++, c_tiles = bound++, c_edram = bound++;
+  std::vector<uint32_t> out(in.begin(), in.begin() + 5);
+  for (size_t i = 5; i < in.size();) {
+    const uint32_t count = in[i] >> 16, op = in[i] & 0xFFFF;
+    std::vector<uint32_t> inst(in.begin() + i, in.begin() + i + count);
+    i += count;
+    if (op == kOpBitwiseAnd && count == 5 && inst[4] == const_2047 &&
+        std::find(shifted_by_13.begin(), shifted_by_13.end(), inst[3]) != shifted_by_13.end()) {
+      const uint32_t result = inst[2], shifted = inst[3];
+      const uint32_t low = bound++, high_shifted = bound++, high = bound++;
+      inst[2] = low;
+      out.insert(out.end(), inst.begin(), inst.end());
+      out.insert(out.end(), {(5u << 16) | kOpShiftRightLogical, uint_type, high_shifted, shifted, c6});
+      out.insert(out.end(), {(5u << 16) | kOpBitwiseAnd, uint_type, high, high_shifted, c2048});
+      out.insert(out.end(), {(5u << 16) | kOpBitwiseOr, uint_type, result, low, high});
+      continue;
+    }
+    if (op == kOpUMod && count == 5 && const_edram && inst[4] == const_edram) inst[4] = c_edram;
+    if (op == kOpIMul && count == 5 &&
+        std::find(edram_size_products.begin(), edram_size_products.end(), inst[2]) !=
+            edram_size_products.end()) {
+      for (size_t j = 3; j < 5; ++j) {
+        if (inst[j] == const_2048) inst[j] = c_tiles;
+      }
+    }
+    out.insert(out.end(), inst.begin(), inst.end());
+    if (op == kOpConstant && count == 4 && inst[2] == const_2047) {
+      out.insert(out.end(), {(4u << 16) | kOpConstant, uint_type, c6, 6});
+      out.insert(out.end(), {(4u << 16) | kOpConstant, uint_type, c2048, 2048});
+      out.insert(out.end(), {(4u << 16) | kOpConstant, uint_type, c_tiles, xenos::kEdramTileCount});
+      out.insert(out.end(),
+                 {(4u << 16) | kOpConstant, uint_type, c_edram, xenos::kEdramTileCount * 1280});
+    }
+  }
+  out[3] = bound;
+  return out;
+}
