+VkPipeline CreateEdramComputePipeline(const ui::vulkan::VulkanDevice* vulkan_device,
+                                      VkPipelineLayout layout, const uint32_t* code,
+                                      size_t size_bytes) {
+  const std::vector<uint32_t> adapted = AdaptEdramShader(code, size_bytes);
+  return ui::vulkan::util::CreateComputePipeline(vulkan_device, layout, adapted.data(),
+                                                 adapted.size() * sizeof(uint32_t));
+}
