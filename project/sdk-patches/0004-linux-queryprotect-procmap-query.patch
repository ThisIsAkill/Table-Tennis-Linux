+// PROCMAP_QUERY (Linux 6.11+) returns the mapping that contains an address with one ioctl
+// on /proc/self/maps instead of parsing the whole file as text. The parse took long enough
+// to slow games down badly: QueryProtect runs on every guest write to a watched page.
+// The UAPI struct is defined here so older kernel headers can build it; the ioctl number
+// encodes its size (104 bytes), which must match the kernel's.
+struct ProcmapQuery {
+  uint64_t size;
+  uint64_t query_flags;
+  uint64_t query_addr;
+  uint64_t vma_start;
+  uint64_t vma_end;
+  uint64_t vma_flags;
+  uint64_t vma_page_size;
+  uint64_t vma_offset;
+  uint64_t inode;
+  uint32_t dev_major;
+  uint32_t dev_minor;
+  uint32_t vma_name_size;
+  uint32_t build_id_size;
+  uint64_t vma_name_addr;
+  uint64_t build_id_addr;
+};
+static_assert(sizeof(ProcmapQuery) == 104, "procmap_query layout");
+constexpr unsigned long kProcmapQueryIoctl = _IOWR('f', 17, ProcmapQuery);
+constexpr uint64_t kProcmapVmaReadable = 0x01;
+constexpr uint64_t kProcmapVmaWritable = 0x02;
+constexpr uint64_t kProcmapVmaExecutable = 0x04;
+constexpr uint64_t kProcmapVmaShared = 0x08;
+constexpr uint64_t kProcmapCoveringOrNext = 0x10;
+
+// Returns 1 if a mapping was found, 0 if none matched, -1 if the ioctl is unavailable.
+static int ProcmapQueryEntry(uintptr_t addr, uint64_t flags, LinuxMapEntry& out) {
+  static std::atomic<int> maps_fd{-2};
+  static std::atomic<bool> unsupported{false};
+  if (unsupported.load(std::memory_order_relaxed)) {
+    return -1;
+  }
+  int fd = maps_fd.load(std::memory_order_acquire);
+  if (fd == -2) {
+    int opened = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    int expected = -2;
+    if (!maps_fd.compare_exchange_strong(expected, opened, std::memory_order_acq_rel)) {
+      if (opened >= 0) {
+        close(opened);
+      }
+    }
+    fd = maps_fd.load(std::memory_order_acquire);
+  }
+  if (fd < 0) {
+    unsupported.store(true, std::memory_order_relaxed);
+    return -1;
+  }
+  ProcmapQuery query = {};
+  query.size = sizeof(query);
+  query.query_flags = flags;
+  query.query_addr = addr;
+  if (ioctl(fd, kProcmapQueryIoctl, &query) != 0) {
+    if (errno == ENOENT) {
+      return 0;
+    }
+    if (errno == ENOTTY || errno == EINVAL || errno == EOPNOTSUPP) {
+      unsupported.store(true, std::memory_order_relaxed);
+    }
+    return -1;
+  }
+  out = LinuxMapEntry{};
+  out.start = static_cast<uintptr_t>(query.vma_start);
+  out.end = static_cast<uintptr_t>(query.vma_end);
+  out.perms[0] = (query.vma_flags & kProcmapVmaReadable) ? 'r' : '-';
+  out.perms[1] = (query.vma_flags & kProcmapVmaWritable) ? 'w' : '-';
+  out.perms[2] = (query.vma_flags & kProcmapVmaExecutable) ? 'x' : '-';
+  out.perms[3] = (query.vma_flags & kProcmapVmaShared) ? 's' : 'p';
+  return 1;
+}
