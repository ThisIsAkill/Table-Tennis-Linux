@@ -0,0 +1,108 @@
+/**
+ * @file        rex/system/ranked.h
+ * @brief       Ranked matches and leaderboards on the online server (Xbox LIVE stats stand-in)
+ *
+ * Every copy of a title has the same profile XUID, so players are told apart by an online
+ * account instead: a player name claimed on the server plus a random secret per device, kept in
+ * the user data folder (online_account.txt). A device can join an existing account with a
+ * one-time link code shown on a device that already has it. Stat writes are signed with the
+ * device secret (HMAC-SHA256), so the secret itself is only sent once, when it is registered.
+ *
+ * The game's XSessionWriteStats calls for the local player are collected per session and sent
+ * when the session's stats are flushed or it ends; XUserReadStats and stats enumerators read the
+ * server's leaderboards.
+ */
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rex::system::ranked {
+
+// Account state, for the settings screen.
+enum class AccountStatus {
+  kOffline,    // online play off or no server set
+  kPending,    // a request to the server is in progress
+  kReady,      // account known: AccountName() is the name on the leaderboards
+  kNameTaken,  // the player name belongs to another account: link this device or rename
+  kError,      // the server could not be reached or refused the request
+};
+
+AccountStatus GetAccountStatus();
+std::string AccountName();
+// Claims the player name for this device in the background when there is no account yet (or the
+// name changed). Safe to call often.
+void EnsureAccount();
+
+// Link codes. RequestLinkCode asks the server for a code for this device's account; LinkCode()
+// returns it once it arrives ("" while pending). RedeemLinkCode joins this device to the account
+// that showed the code; LinkMessage() describes the result.
+void RequestLinkCode();
+std::string LinkCode();
+void RedeemLinkCode(const std::string& code);
+std::string LinkMessage();
+
+// The XUID the title uses for the local player in network sessions; stats written for any other
+// XUID belong to other players and are not sent.
+void SetLocalXuid(uint64_t xuid);
+// That XUID, or the profile's while the title has not set one.
+uint64_t LocalXuid();
+
+struct StatValue {
+  uint32_t property_id;
+  double value;
+};
+
+// XSessionWriteStats for one player and one view.
+void WriteStats(uint64_t session_id, uint64_t xuid, uint32_t view_id,
+                const std::vector<StatValue>& values);
+// XSessionFlushStats / XSessionEnd: sends the session's collected stats.
+void FlushStats(uint64_t session_id);
+
+// One leaderboard row as the server returns it.
+struct Row {
+  uint32_t rank = 0;
+  std::string online_id;
+  std::string gamertag;
+  double rating = 0;
+  std::vector<std::pair<uint16_t, double>> columns;  // column id -> value
+  uint32_t skill = 0;
+  bool is_local = false;
+};
+
+// Reads one page of a leaderboard view. start is a 1-based rank; around_local centres the page on
+// this account. Blocks for up to a few seconds; false when the server cannot be reached.
+bool ReadLeaderboard(uint32_t view_id, uint32_t start, uint32_t count, bool around_local,
+                     uint32_t* total, std::vector<Row>* rows);
+
+// Leaderboard results in the title's XUSER_STATS_READ_RESULTS layout (big-endian, with guest
+// pointers into the same buffer). One entry per XUSER_STATS_SPEC the title asked for.
+struct ViewRequest {
+  uint32_t view_id = 0;
+  std::vector<uint16_t> column_ids;
+};
+struct ViewResult {
+  uint32_t total_rows = 0;
+  std::vector<Row> rows;
+};
+// Parses count XUSER_STATS_SPEC entries (136 bytes each) at specs.
+std::vector<ViewRequest> ParseStatsSpecs(const uint8_t* specs, uint32_t count);
+// Bytes needed for results with up to max_rows rows per view.
+uint32_t StatsResultsSize(const std::vector<ViewRequest>& requests, uint32_t max_rows);
+// Fetches every requested view: a page from start (or around this account), or, with
+// local_only, just this account's row.
+std::vector<ViewResult> FetchViews(const std::vector<ViewRequest>& requests, uint32_t start,
+                                   uint32_t count, bool around_local, bool local_only);
+// The rows of the given players (by the XUIDs this client handed out in earlier leaderboard
+// reads, or the local player's) in every requested view, in the order of xuids.
+std::vector<ViewResult> FetchPlayers(const std::vector<ViewRequest>& requests,
+                                     const std::vector<uint64_t>& xuids);
+// Writes the results at out, which the title sees at guest_address. local_xuid is used for this
+// account's rows; other players get a stable made-up XUID.
+void WriteStatsResults(uint8_t* out, uint32_t guest_address,
+                       const std::vector<ViewRequest>& requests,
+                       const std::vector<ViewResult>& results, uint64_t local_xuid);
+
+}  // namespace rex::system::ranked
