+// Logs every view/property a ranked match reports (XSESSION_VIEW_PROPERTIES -> XUSER_PROPERTY),
+// raw, so the leaderboard writer can be matched against the title's XVC2 schema.
+template <typename Mem>
+static void LogStatsViews(Mem* memory, const char* what, uint64_t xuid, uint32_t num_views,
+                          uint32_t views_ptr) {
+  for (uint32_t v = 0; v < num_views && v < 64 && views_ptr; ++v) {
+    const uint8_t* view = memory->template TranslateVirtual<const uint8_t*>(views_ptr + v * 12);
+    uint32_t view_id = memory::load_and_swap<uint32_t>(view + 0);
+    uint32_t num_props = memory::load_and_swap<uint32_t>(view + 4);
+    uint32_t props_ptr = memory::load_and_swap<uint32_t>(view + 8);
+    for (uint32_t p = 0; p < num_props && p < 64 && props_ptr; ++p) {
+      const uint8_t* prop = memory->template TranslateVirtual<const uint8_t*>(props_ptr + p * 24);
+      std::string hex;
+      for (int i = 0; i < 24; ++i) hex += fmt::format("{:02X}", prop[i]);
+      REXKRNL_DEBUG("{} xuid={:016X} view={:08X} prop[{}] id={:08X} raw={}", what, xuid, view_id, p,
+                   memory::load_and_swap<uint32_t>(prop), hex);
+    }
+    if (!num_props) REXKRNL_DEBUG("{} xuid={:016X} view={:08X} (no properties)", what, xuid, view_id);
+  }
+}
+// Forwards one XSessionWriteStats call (XUSER_STATS_VIEW entries of 12 bytes, XUSER_PROPERTY
+// entries of 24: id, pad, XUSER_DATA {type, pad, value}) to the online leaderboards.
+template <typename Mem>
+static void ForwardStatsViews(Mem* memory, uint32_t session, uint64_t xuid, uint32_t num_views,
+                              uint32_t views_ptr) {
+  for (uint32_t v = 0; v < num_views && v < 64 && views_ptr; ++v) {
+    const uint8_t* view = memory->template TranslateVirtual<const uint8_t*>(views_ptr + v * 12);
+    const uint32_t view_id = memory::load_and_swap<uint32_t>(view + 0);
+    const uint32_t num_props = memory::load_and_swap<uint32_t>(view + 4);
+    const uint32_t props_ptr = memory::load_and_swap<uint32_t>(view + 8);
+    std::vector<rex::system::ranked::StatValue> values;
+    for (uint32_t p = 0; p < num_props && p < 64 && props_ptr; ++p) {
+      const uint8_t* prop = memory->template TranslateVirtual<const uint8_t*>(props_ptr + p * 24);
+      const uint32_t id = memory::load_and_swap<uint32_t>(prop);
+      const uint8_t type = prop[8];
+      double value;
+      switch (type) {
+        case 1:  // int32
+          value = int32_t(memory::load_and_swap<uint32_t>(prop + 16));
+          break;
+        case 2:  // int64
+          value = double(int64_t(memory::load_and_swap<uint64_t>(prop + 16)));
+          break;
+        case 3:  // double
+          value = memory::load_and_swap<double>(prop + 16);
+          break;
+        case 5:  // float
+          value = memory::load_and_swap<float>(prop + 16);
+          break;
+        default:
+          continue;
+      }
+      values.push_back({id, value});
+    }
+    rex::system::ranked::WriteStats(session, xuid, view_id, values);
+  }
+}
