+// Leaderboard reads (XUserCreateStatsEnumeratorByRank / ByXuid) from the online server. The
+// results are one XUSER_STATS_READ_RESULTS block with pointers into the caller's buffer, so the
+// enumerator writes them when it knows that buffer's address.
+class XStatsEnumerator : public XEnumerator {
+ public:
+  XStatsEnumerator(KernelState* kernel_state, uint32_t size,
+                   std::vector<rex::system::ranked::ViewRequest> requests,
+                   std::vector<rex::system::ranked::ViewResult> results, uint64_t local_xuid)
+      : XEnumerator(kernel_state, 1, size),
+        requests_(std::move(requests)),
+        results_(std::move(results)),
+        local_xuid_(local_xuid) {}
+
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data,
+                      uint32_t* written_count) override {
+    if (written_) return X_ERROR_NO_MORE_FILES;
+    written_ = true;
+    std::memset(buffer_data, 0, item_size());
+    rex::system::ranked::WriteStatsResults(buffer_data, buffer_ptr, requests_, results_,
+                                           local_xuid_);
+    if (written_count) *written_count = 1;
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  std::vector<rex::system::ranked::ViewRequest> requests_;
+  std::vector<rex::system::ranked::ViewResult> results_;
+  uint64_t local_xuid_;
+  bool written_ = false;
+};
+
+// mode 1: rows from rank `pivot` (1-based); mode 0: rows around the player with XUID `pivot`.
+u32 XamUserCreateStatsEnumerator_entry(u32 title_id, u32 mode, u64 pivot, u32 num_rows,
+                                       u32 num_specs, mapped_void specs_ptr,
+                                       mapped_u32 buffer_size_ptr, mapped_u32 handle_ptr) {
+  if (!num_rows || num_rows > 100 || !num_specs || num_specs > 64 || !specs_ptr ||
+      !buffer_size_ptr) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  auto requests = rex::system::ranked::ParseStatsSpecs(specs_ptr.as<const uint8_t*>(), num_specs);
+  const uint32_t size = rex::system::ranked::StatsResultsSize(requests, num_rows);
+  *buffer_size_ptr = size;
+  if (!handle_ptr) return X_ERROR_SUCCESS;  // size query only
+
+  const uint64_t local_xuid = rex::system::ranked::LocalXuid();
+  const bool around_player = mode == 0;
+  const uint32_t start = around_player ? 1 : std::max<uint32_t>(1, uint32_t(pivot));
+  auto results =
+      rex::system::ranked::FetchViews(requests, start, num_rows, around_player, false);
+  REXKRNL_INFO("XamUserCreateStatsEnumerator({:08X}, {}, {:X}, rows {}, views {}): {} rows",
+               title_id, around_player ? "around player" : "by rank", pivot, num_rows,
+               num_specs, results.empty() ? 0 : results[0].rows.size());
+
+  for (const auto& request : requests) {
+    std::string ids;
+    for (uint16_t id : request.column_ids) ids += fmt::format(" {:04X}", id);
+    REXKRNL_DEBUG("  view {:08X} columns:{}", request.view_id, ids);
+  }
+  auto e = object_ref<XStatsEnumerator>(new XStatsEnumerator(
+      REX_KERNEL_STATE(), size, std::move(requests), std::move(results), local_xuid));
+  auto result = e->Initialize(0xFF, 0xFB, 0xB0022, 0xB0023, 0);
+  if (XFAILED(result)) return result;
+  *handle_ptr = e->handle();
+  return X_ERROR_SUCCESS;
+}
