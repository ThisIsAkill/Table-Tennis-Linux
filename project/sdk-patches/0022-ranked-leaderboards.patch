+namespace rex::system::ranked {
+namespace {
+using json = nlohmann::json;
+constexpr uint16_t kDefaultServerPort = 27360;
+constexpr int kTimeoutMs = 4000;      // background requests
+constexpr int kReadTimeoutMs = 2000;  // leaderboard reads, which the title waits for
+
+// --- crypto ---------------------------------------------------------------------------------
+std::string Hex(const uint8_t* data, size_t size) {
+  static const char* digits = "0123456789abcdef";
+  std::string out;
+  for (size_t i = 0; i < size; ++i) {
+    out += digits[data[i] >> 4];
+    out += digits[data[i] & 15];
+  }
+  return out;
+}
+
+std::string RandomHex(size_t bytes) {
+  std::random_device device;
+  std::vector<uint8_t> data(bytes);
+  for (auto& b : data) b = uint8_t(device());
+  return Hex(data.data(), data.size());
+}
+
+std::string HmacSha256Hex(const std::string& key, const std::string& message) {
+  constexpr size_t kBlock = sha256::SHA256::BlockSize;
+  uint8_t k[kBlock] = {};
+  if (key.size() > kBlock) {
+    sha256::SHA256 h;
+    h.add(key.data(), key.size());
+    h.getHash(k);
+  } else {
+    std::memcpy(k, key.data(), key.size());
+  }
+  uint8_t inner_pad[kBlock], outer_pad[kBlock];
+  for (size_t i = 0; i < kBlock; ++i) {
+    inner_pad[i] = k[i] ^ 0x36;
+    outer_pad[i] = k[i] ^ 0x5C;
+  }
+  uint8_t inner[sha256::SHA256::HashBytes], outer[sha256::SHA256::HashBytes];
+  sha256::SHA256 hi;
+  hi.add(inner_pad, kBlock);
+  hi.add(message.data(), message.size());
+  hi.getHash(inner);
+  sha256::SHA256 ho;
+  ho.add(outer_pad, kBlock);
+  ho.add(inner, sizeof(inner));
+  ho.getHash(outer);
+  return Hex(outer, sizeof(outer));
+}
+
+// --- HTTP -----------------------------------------------------------------------------------
+struct Response {
+  int status = 0;  // 0: no answer
+  json body;
+};
+
+bool ServerAddress(std::string* host, uint16_t* port) {
+  std::string text = REXCVAR_GET(online_server);
+  if (text.empty()) return false;
+  *port = kDefaultServerPort;
+  const size_t colon = text.rfind(':');
+  if (colon != std::string::npos) {
+    *port = uint16_t(std::atoi(text.c_str() + colon + 1));
+    text.resize(colon);
+  }
+  *host = text;
+  return !host->empty() && *port;
+}
+
+void CloseSocket(intptr_t fd) {
+#if REX_PLATFORM_WIN32
+  closesocket(SOCKET(fd));
+#else
+  close(int(fd));
+#endif
+}
+
+// One HTTP/1.0 request to the online server's TCP port (the server answers and closes).
+Response Http(const std::string& method, const std::string& target, const std::string& body,
+              int timeout_ms = kTimeoutMs) {
+  Response result;
+  std::string host;
+  uint16_t port;
+  if (!ServerAddress(&host, &port)) return result;
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* address = nullptr;
+  if (getaddrinfo(host.c_str(), std::to_string(port).c_str(), &hints, &address) != 0 || !address) {
+    return result;
+  }
+  const auto fd = intptr_t(socket(AF_INET, SOCK_STREAM, 0));
+  if (fd < 0) {
+    freeaddrinfo(address);
+    return result;
+  }
+#if REX_PLATFORM_WIN32
+  DWORD timeout = DWORD(timeout_ms);
+#else
+  timeval timeout{timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+#endif
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&timeout), sizeof(timeout));
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, reinterpret_cast<const char*>(&timeout), sizeof(timeout));
+  const bool connected = connect(fd, address->ai_addr, socklen_t(address->ai_addrlen)) == 0;
+  freeaddrinfo(address);
+  if (!connected) {
+    CloseSocket(fd);
+    return result;
+  }
+  std::string request = method + " " + target + " HTTP/1.0\r\nHost: " + host +
+                        "\r\nContent-Type: application/json\r\nContent-Length: " +
+                        std::to_string(body.size()) + "\r\nConnection: close\r\n\r\n" + body;
+  for (size_t sent = 0; sent < request.size();) {
+    const auto n = send(fd, request.data() + sent, int(request.size() - sent), 0);
+    if (n <= 0) {
+      CloseSocket(fd);
+      return result;
+    }
+    sent += size_t(n);
+  }
+  std::string reply;
+  char buffer[4096];
+  while (reply.size() < (1u << 20)) {
+    const auto n = recv(fd, buffer, sizeof(buffer), 0);
+    if (n <= 0) break;
+    reply.append(buffer, size_t(n));
+  }
+  CloseSocket(fd);
+  const size_t space = reply.find(' ');
+  const size_t header_end = reply.find("\r\n\r\n");
+  if (reply.rfind("HTTP/", 0) != 0 || space == std::string::npos || header_end == std::string::npos) {
+    return result;
+  }
+  result.status = std::atoi(reply.c_str() + space + 1);
+  result.body = json::parse(reply.begin() + header_end + 4, reply.end(), nullptr, false);
+  if (result.body.is_discarded()) result.body = json::object();
+  return result;
+}
+
+std::string UrlEncode(const std::string& text) {
+  std::string out;
+  for (unsigned char c : text) {
+    if (std::isalnum(c) || c == '-' || c == '_' || c == '.') {
+      out += char(c);
+    } else {
+      out += fmt::format("%{:02X}", c);
+    }
+  }
+  return out;
+}
+
+// --- account --------------------------------------------------------------------------------
+struct Account {
+  std::string device, secret, online_id, name;
+};
+
+class Client {
+ public:
+  static Client& Get() {
+    static Client client;
+    return client;
+  }
+
+  AccountStatus status() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!rex::system::net::OnlineEnabled() && status_ != AccountStatus::kPending) {
+      return AccountStatus::kOffline;
+    }
+    return status_;
+  }
+  std::string name() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return account_.name;
+  }
+  std::string link_code() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return link_code_;
+  }
+  std::string link_message() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return link_message_;
+  }
+  std::string online_id() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Load();
+    return account_.online_id;
+  }
+
+  void EnsureAccount() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Load();
+    const std::string wanted = PlayerName();
+    if (busy_ || wanted.empty() || !rex::system::net::OnlineEnabled()) return;
+    if (!account_.online_id.empty() && account_.name == wanted) {
+      status_ = AccountStatus::kReady;
+      return;
+    }
+    if (claim_failed_for_ == wanted) return;  // already refused; wait for a rename or a link
+    Start(true, [this, wanted] {
+      json request = {{"name", wanted}, {"device", account_.device}, {"secret", account_.secret}};
+      const Response r = Http("POST", "/api/claim", request.dump());
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (r.status == 200 && r.body.contains("online_id")) {
+        account_.online_id = r.body.value("online_id", "");
+        account_.name = r.body.value("name", wanted);
+        Save();
+        status_ = AccountStatus::kReady;
+        REXSYS_INFO("Ranked: signed in as {}", account_.name);
+      } else if (r.status == 409) {
+        claim_failed_for_ = wanted;
+        status_ = AccountStatus::kNameTaken;
+        REXSYS_INFO("Ranked: the name {} belongs to another account", wanted);
+      } else {
+        status_ = AccountStatus::kError;
+        REXSYS_WARN("Ranked: claiming {} failed (HTTP {})", wanted, r.status);
+      }
+    });
+  }
+
+  void RequestLinkCode() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Load();
+    link_code_.clear();
+    if (account_.online_id.empty()) {
+      link_message_ = "NO ACCOUNT ON THIS DEVICE YET";
+      return;
+    }
+    link_message_ = "";
+    Start(false, [this] {
+      const Response r = Signed("/api/link/create", "{}");
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (r.status == 200) {
+        link_code_ = r.body.value("code", "");
+      } else {
+        link_message_ = r.status ? "SERVER REFUSED THE REQUEST" : "SERVER NOT REACHABLE";
+      }
+    });
+  }
+
+  void RedeemLinkCode(const std::string& code) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Load();
+    link_message_ = "LINKING...";
+    Start(false, [this, code] {
+      json request = {{"code", code}, {"device", account_.device}, {"secret", account_.secret}};
+      const Response r = Http("POST", "/api/link/redeem", request.dump());
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (r.status == 200) {
+        account_.online_id = r.body.value("online_id", "");
+        account_.name = r.body.value("name", "");
+        Save();
+        claim_failed_for_.clear();
+        status_ = AccountStatus::kReady;
+        link_message_ = "LINKED TO " + account_.name;
+        // The leaderboards show the account name; make the player name match it.
+        rex::cvar::SetFlagByName("user_name", account_.name);
+        REXSYS_INFO("Ranked: device linked to {}", account_.name);
+      } else if (r.status == 404) {
+        link_message_ = "WRONG OR EXPIRED CODE";
+      } else {
+        link_message_ = r.status ? "SERVER REFUSED THE REQUEST" : "SERVER NOT REACHABLE";
+      }
+    });
+  }
+
+  // Signed POST: ?device=ID&ts=UNIX&sig=HMAC(secret, path\nts\nbody).
+  Response Signed(const std::string& path, const std::string& body) {
+    std::string device, secret;
+    {
+      std::lock_guard<std::mutex> lock(account_mutex_);
+      device = account_.device;
+      secret = account_.secret;
+    }
+    const std::string ts = std::to_string(
+        std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count());
+    const std::string sig = HmacSha256Hex(secret, path + "\n" + ts + "\n" + body);
+    return Http("POST", path + "?device=" + device + "&ts=" + ts + "&sig=" + sig, body);
+  }
+
+  // Runs a request in the background. Account requests (claims) run one at a time and show as
+  // pending in the account status; link requests leave the status alone.
+  template <typename F>
+  void Start(bool account_request, F&& work) {
+    if (account_request) {
+      busy_ = true;
+      status_ = AccountStatus::kPending;
+    }
+    std::thread([this, account_request, work = std::forward<F>(work)]() mutable {
+      work();
+      if (!account_request) return;
+      std::lock_guard<std::mutex> lock(mutex_);
+      busy_ = false;
+      if (status_ == AccountStatus::kPending) status_ = AccountStatus::kError;
+    }).detach();
+  }
+
+  std::mutex mutex_;
+  std::mutex account_mutex_;
+
+ private:
+  std::filesystem::path Path() const {
+    auto* kernel = rex::system::kernel_state();
+    std::filesystem::path root = kernel ? kernel->emulator()->user_data_root() : "";
+    return root.empty() ? std::filesystem::path("online_account.txt") : root / "online_account.txt";
+  }
+
+  static std::string PlayerName() {
+    std::string name;
+    for (char c : std::string(REXCVAR_GET(user_name))) {
+      if (std::isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '_') name += c;
+      if (name.size() == 15) break;
+    }
+    if (name.empty()) {
+      if (auto* kernel = rex::system::kernel_state()) {
+        for (char c : kernel->user_profile()->name()) {
+          if (std::isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '_') name += c;
+          if (name.size() == 15) break;
+        }
+      }
+    }
+    return name;
+  }
+
+  // Reads online_account.txt once; creates the device identity when there is none.
+  void Load() {
+    if (loaded_) return;
+    loaded_ = true;
+    std::ifstream in(Path());
+    std::string line;
+    while (std::getline(in, line)) {
+      const size_t eq = line.find('=');
+      if (eq == std::string::npos) continue;
+      const std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+      if (key == "device") account_.device = value;
+      if (key == "secret") account_.secret = value;
+      if (key == "online_id") account_.online_id = value;
+      if (key == "name") account_.name = value;
+    }
+    if (account_.device.size() < 16 || account_.secret.size() < 32) {
+      account_ = {RandomHex(16), RandomHex(32), "", ""};
+      Save();
+    }
+    if (!account_.online_id.empty()) status_ = AccountStatus::kReady;
+  }
+
+  void Save() {
+    std::lock_guard<std::mutex> lock(account_mutex_);
+    const auto path = Path();
+    const auto temp = std::filesystem::path(path.string() + ".tmp");
+    {
+      std::ofstream out(temp, std::ios::trunc);
+      out << "# Online account for ranked matches and leaderboards. Keep this file private:\n"
+             "# the secret proves to the server that this device belongs to the account.\n"
+          << "device=" << account_.device << "\nsecret=" << account_.secret
+          << "\nonline_id=" << account_.online_id << "\nname=" << account_.name << "\n";
+    }
+#if !REX_PLATFORM_WIN32
+    chmod(temp.string().c_str(), 0600);
+#endif
+    std::error_code ec;
+    std::filesystem::rename(temp, path, ec);
+  }
+
+  Account account_;
+  bool loaded_ = false;
+  bool busy_ = false;
+  AccountStatus status_ = AccountStatus::kOffline;
+  std::string claim_failed_for_;
+  std::string link_code_, link_message_;
+};
+
+// --- stats ----------------------------------------------------------------------------------
+// The ranked TrueSkill view (system view); the title writes it only for ranked matches.
+constexpr uint32_t kTrueSkillView = 0xFFFF0000;
+// Match results in the title's stats views: games won, as written for each player.
+constexpr uint32_t kWinsProperty = 0x20000019;
+
+struct PendingSession {
+  std::map<uint32_t, std::map<uint32_t, double>> views;  // this player: view -> property -> value
+  std::set<uint64_t> players;  // every XUID the title wrote stats for (both players)
+  uint64_t local = 0;
+  bool ranked = false;
+};
+
+std::mutex stats_mutex;
+uint64_t local_xuid = 0;
+// XUIDs handed to the title for other players' leaderboard rows -> their online IDs, so the
+// title can read those players' other stats by XUID afterwards.
+std::map<uint64_t, std::string> known_players;
+std::map<uint64_t, PendingSession> pending_stats;
+
+}  // namespace
+
+AccountStatus GetAccountStatus() { return Client::Get().status(); }
+std::string AccountName() { return Client::Get().name(); }
+void EnsureAccount() { Client::Get().EnsureAccount(); }
+void RequestLinkCode() { Client::Get().RequestLinkCode(); }
+std::string LinkCode() { return Client::Get().link_code(); }
+void RedeemLinkCode(const std::string& code) { Client::Get().RedeemLinkCode(code); }
+std::string LinkMessage() { return Client::Get().link_message(); }
+
+void SetLocalXuid(uint64_t xuid) {
+  std::lock_guard<std::mutex> lock(stats_mutex);
+  local_xuid = xuid;
+}
+
+uint64_t LocalXuid() {
+  {
+    std::lock_guard<std::mutex> lock(stats_mutex);
+    if (local_xuid) return local_xuid;
+  }
+  auto* kernel = rex::system::kernel_state();
+  return kernel ? kernel->user_profile()->xuid() : 0;
+}
+
+void WriteStats(uint64_t session_id, uint64_t xuid, uint32_t view_id,
+                const std::vector<StatValue>& values) {
+  auto* kernel = rex::system::kernel_state();
+  const uint64_t profile_xuid = kernel ? kernel->user_profile()->xuid() : 0;
+  std::lock_guard<std::mutex> lock(stats_mutex);
+  // The title writes the local player's stats under its profile XUID or the session XUID.
+  const bool local = xuid == profile_xuid || (local_xuid && xuid == local_xuid);
+  REXSYS_DEBUG("Ranked: stats for {:016X} ({}), view {:#x}, {} values", xuid,
+               local ? "this player" : "another player", view_id, values.size());
+  if (!rex::system::net::OnlineEnabled()) return;
+  auto& session = pending_stats[session_id];
+  session.players.insert(xuid);
+  if (!local) return;
+  session.local = xuid;
+  if (view_id == kTrueSkillView) {
+    session.ranked = true;
+    return;  // the server keeps TrueSkill itself from the agreed results
+  }
+  auto& props = session.views[view_id];
+  for (const auto& v : values) props[v.property_id] = v.value;
+}
+
+void FlushStats(uint64_t session_id) {
+  PendingSession session;
+  {
+    std::lock_guard<std::mutex> lock(stats_mutex);
+    auto it = pending_stats.find(session_id);
+    if (it == pending_stats.end()) return;
+    session = std::move(it->second);
+    pending_stats.erase(it);
+  }
+  if (session.views.empty()) return;
+  json views = json::array();
+  for (const auto& [view_id, props] : session.views) {
+    json p = json::object();
+    for (const auto& [prop, value] : props) p[fmt::format("{:#x}", prop)] = value;
+    views.push_back({{"view", view_id}, {"props", p}});
+  }
+  json request = {{"views", views}};
+  // Ranked 1v1: both players report the result under the same key (their two XUIDs, which each
+  // side's title wrote stats for); the server moves TrueSkill only when the reports agree.
+  if (session.ranked && session.players.size() == 2 && session.local) {
+    const uint64_t a = *session.players.begin(), b = *session.players.rbegin();
+    double wins = 0;
+    for (const auto& [view_id, props] : session.views) {
+      auto it = props.find(kWinsProperty);
+      if (it != props.end()) wins = std::max(wins, it->second);
+    }
+    request["ranked"] = {{"session", fmt::format("{:016x}{:016x}", a, b)}, {"won", wins > 0}};
+    REXSYS_INFO("Ranked: reporting a {} in a ranked match", wins > 0 ? "win" : "loss");
+  }
+  const std::string body = request.dump();
+  Client::Get().EnsureAccount();
+  std::thread([body] {
+    // The account claim may still be on its way the first time.
+    for (int attempt = 0; attempt < 5; ++attempt) {
+      if (Client::Get().online_id().empty()) {
+        std::this_thread::sleep_for(std::chrono::seconds(2));
+        continue;
+      }
+      const Response r = Client::Get().Signed("/api/stats", body);
+      if (r.status == 200) {
+        REXSYS_INFO("Ranked: stats sent ({} properties applied)", r.body.value("applied", 0));
+        return;
+      }
+      REXSYS_WARN("Ranked: sending stats failed (HTTP {})", r.status);
+      if (r.status == 400 || r.status == 403) return;
+      std::this_thread::sleep_for(std::chrono::seconds(3));
+    }
+  }).detach();
+}
+
+bool ReadLeaderboard(uint32_t view_id, uint32_t start, uint32_t count, bool around_local,
+                     uint32_t* total, std::vector<Row>* rows) {
+  rows->clear();
+  *total = 0;
+  if (!rex::system::net::OnlineEnabled()) return false;
+  const std::string self = Client::Get().online_id();
+  std::string target = fmt::format("/api/leaderboard?view={}&start={}&count={}", view_id,
+                                   std::max(1u, start), std::max(1u, count));
+  if (around_local && !self.empty()) target += "&pivot=" + UrlEncode(self);
+  const Response r = Http("GET", target, "", kReadTimeoutMs);
+  if (r.status != 200) return false;
+  *total = r.body.value("total", 0u);
+  for (const auto& item : r.body.value("rows", json::array())) {
+    Row row;
+    row.rank = item.value("rank", 0u);
+    row.online_id = item.value("online_id", "");
+    row.gamertag = item.value("gamertag", "");
+    row.rating = item.value("rating", 0.0);
+    row.skill = item.value("skill", 0u);
+    row.is_local = !self.empty() && row.online_id == self;
+    for (const auto& [key, value] : item.value("columns", json::object()).items()) {
+      row.columns.emplace_back(uint16_t(std::strtoul(key.c_str(), nullptr, 10)),
+                               value.is_number() ? value.get<double>() : 0.0);
+    }
+    rows->push_back(std::move(row));
+  }
+  return true;
+}
+
+namespace {
+// XUSER_STATS_SPEC: view id, column count, 64 column ids.
+constexpr uint32_t kSpecSize = 136;
+constexpr uint32_t kMaxSpecColumns = 64;
+// XUSER_STATS_READ_RESULTS {views, pViews}; XUSER_STATS_VIEW {id, total, rows, pRows};
+// XUSER_STATS_ROW {xuid, rank, pad, rating, gamertag[16], columns, pColumns};
+// XUSER_STATS_COLUMN {id, pad, XUSER_DATA {type, pad, value}}.
+constexpr uint32_t kResultsSize = 8, kViewSize = 16, kRowSize = 48, kColumnSize = 24;
+constexpr uint8_t kDataInt64 = 2;
+constexpr uint16_t kRatingColumn = 0xFFFE, kRankColumn = 0xFFFF;
+
+uint32_t LoadBe32(const uint8_t* p) { return uint32_t(p[0]) << 24 | p[1] << 16 | p[2] << 8 | p[3]; }
+void StoreBe16(uint8_t* p, uint16_t v) {
+  p[0] = uint8_t(v >> 8);
+  p[1] = uint8_t(v);
+}
+void StoreBe32(uint8_t* p, uint32_t v) {
+  for (int i = 0; i < 4; ++i) p[i] = uint8_t(v >> (24 - 8 * i));
+}
+void StoreBe64(uint8_t* p, uint64_t v) {
+  for (int i = 0; i < 8; ++i) p[i] = uint8_t(v >> (56 - 8 * i));
+}
+
+// Other players have no XUID of their own here; derive a stable one from their online ID
+// (online XUIDs start with 0x0009).
+uint64_t RowXuid(const Row& row, uint64_t local_xuid) {
+  if (row.is_local && local_xuid) return local_xuid;
+  uint64_t hash = 1469598103934665603ull;  // FNV-1a
+  for (unsigned char c : row.online_id) hash = (hash ^ c) * 1099511628211ull;
+  return 0x0009000000000000ull | (hash & 0x0000FFFFFFFFFFFFull);
+}
+
+double ColumnValue(const Row& row, uint16_t column_id) {
+  if (column_id == kRatingColumn) return row.rating;
+  if (column_id == kRankColumn) return row.rank;
+  for (const auto& [id, value] : row.columns) {
+    if (id == column_id) return value;
+  }
+  return 0;
+}
+}  // namespace
+
+std::vector<ViewRequest> ParseStatsSpecs(const uint8_t* specs, uint32_t count) {
+  std::vector<ViewRequest> requests;
+  for (uint32_t i = 0; i < count && i < 64; ++i) {
+    const uint8_t* spec = specs + i * kSpecSize;
+    ViewRequest request;
+    request.view_id = LoadBe32(spec);
+    const uint32_t columns = std::min(LoadBe32(spec + 4), kMaxSpecColumns);
+    for (uint32_t c = 0; c < columns; ++c) {
+      request.column_ids.push_back(uint16_t(spec[8 + 2 * c] << 8 | spec[9 + 2 * c]));
+    }
+    requests.push_back(std::move(request));
+  }
+  return requests;
+}
+
+uint32_t StatsResultsSize(const std::vector<ViewRequest>& requests, uint32_t max_rows) {
+  uint32_t size = kResultsSize;
+  for (const auto& request : requests) {
+    size += kViewSize + max_rows * (kRowSize + uint32_t(request.column_ids.size()) * kColumnSize);
+  }
+  return size;
+}
+
+std::vector<ViewResult> FetchViews(const std::vector<ViewRequest>& requests, uint32_t start,
+                                   uint32_t count, bool around_local, bool local_only) {
+  std::vector<ViewResult> results(requests.size());
+  for (size_t i = 0; i < requests.size(); ++i) {
+    auto& result = results[i];
+    if (local_only) {
+      // A one-row page centred on this account is this account's row, if it has one.
+      std::vector<Row> rows;
+      if (ReadLeaderboard(requests[i].view_id, 1, 1, true, &result.total_rows, &rows)) {
+        for (auto& row : rows) {
+          if (row.is_local) result.rows.push_back(std::move(row));
+        }
+      }
+    } else {
+      ReadLeaderboard(requests[i].view_id, start, count, around_local, &result.total_rows,
+                      &result.rows);
+      if (result.rows.size() > count) result.rows.resize(count);
+    }
+    const uint64_t local = LocalXuid();
+    std::lock_guard<std::mutex> lock(stats_mutex);
+    for (const auto& row : result.rows) {
+      if (!row.is_local) known_players[RowXuid(row, local)] = row.online_id;
+    }
+  }
+  return results;
+}
+
+std::vector<ViewResult> FetchPlayers(const std::vector<ViewRequest>& requests,
+                                     const std::vector<uint64_t>& xuids) {
+  std::vector<ViewResult> results(requests.size());
+  if (!rex::system::net::OnlineEnabled()) return results;
+  const uint64_t local = LocalXuid();
+  auto* kernel = rex::system::kernel_state();
+  const uint64_t profile_xuid = kernel ? kernel->user_profile()->xuid() : 0;
+  const std::string self = Client::Get().online_id();
+  std::vector<std::string> ids;  // online ID per requested XUID ("" = unknown)
+  {
+    std::lock_guard<std::mutex> lock(stats_mutex);
+    for (uint64_t xuid : xuids) {
+      if (xuid == local || xuid == profile_xuid) {
+        ids.push_back(self);
+      } else {
+        auto it = known_players.find(xuid);
+        ids.push_back(it == known_players.end() ? std::string() : it->second);
+      }
+    }
+  }
+  std::string list;
+  for (const auto& id : ids) {
+    if (id.empty() || list.find(id) != std::string::npos) continue;
+    list += (list.empty() ? "" : ",") + UrlEncode(id);
+  }
+  if (list.empty()) return results;
+  for (size_t i = 0; i < requests.size(); ++i) {
+    const Response r = Http("GET", fmt::format("/api/players?view={}&ids={}", requests[i].view_id,
+                                               list), "", kReadTimeoutMs);
+    if (r.status != 200) continue;
+    results[i].total_rows = r.body.value("total", 0u);
+    std::map<std::string, Row> by_id;
+    for (const auto& item : r.body.value("rows", json::array())) {
+      Row row;
+      row.rank = item.value("rank", 0u);
+      row.online_id = item.value("online_id", "");
+      row.gamertag = item.value("gamertag", "");
+      row.rating = item.value("rating", 0.0);
+      row.skill = item.value("skill", 0u);
+      row.is_local = !self.empty() && row.online_id == self;
+      for (const auto& [key, value] : item.value("columns", json::object()).items()) {
+        row.columns.emplace_back(uint16_t(std::strtoul(key.c_str(), nullptr, 10)),
+                                 value.is_number() ? value.get<double>() : 0.0);
+      }
+      by_id[row.online_id] = std::move(row);
+    }
+    for (const auto& id : ids) {
+      auto it = by_id.find(id);
+      if (!id.empty() && it != by_id.end()) results[i].rows.push_back(it->second);
+    }
+  }
+  return results;
+}
+
+void WriteStatsResults(uint8_t* out, uint32_t guest_address,
+                       const std::vector<ViewRequest>& requests,
+                       const std::vector<ViewResult>& results, uint64_t local_xuid) {
+  const uint32_t views = uint32_t(requests.size());
+  StoreBe32(out, views);
+  StoreBe32(out + 4, guest_address + kResultsSize);
+  uint32_t next = kResultsSize + views * kViewSize;  // rows and columns follow the views
+  for (uint32_t v = 0; v < views; ++v) {
+    const auto& request = requests[v];
+    const auto& result = results[v];
+    const uint32_t rows = uint32_t(result.rows.size());
+    const uint32_t columns = uint32_t(request.column_ids.size());
+    uint8_t* view = out + kResultsSize + v * kViewSize;
+    StoreBe32(view, request.view_id);
+    StoreBe32(view + 4, result.total_rows);
+    StoreBe32(view + 8, rows);
+    StoreBe32(view + 12, rows ? guest_address + next : 0);
+    const uint32_t rows_offset = next;
+    next += rows * kRowSize;
+    for (uint32_t r = 0; r < rows; ++r) {
+      const Row& source = result.rows[r];
+      uint8_t* row = out + rows_offset + r * kRowSize;
+      std::memset(row, 0, kRowSize);
+      StoreBe64(row, RowXuid(source, local_xuid));
+      StoreBe32(row + 8, source.rank);
+      StoreBe64(row + 16, uint64_t(int64_t(source.rating)));
+      std::memcpy(row + 24, source.gamertag.data(), std::min<size_t>(source.gamertag.size(), 15));
+      StoreBe32(row + 40, columns);
+      StoreBe32(row + 44, columns ? guest_address + next : 0);
+      for (uint32_t c = 0; c < columns; ++c) {
+        uint8_t* column = out + next + c * kColumnSize;
+        std::memset(column, 0, kColumnSize);
+        StoreBe16(column, request.column_ids[c]);
+        column[8] = kDataInt64;
+        StoreBe64(column + 16,
+                  uint64_t(int64_t(ColumnValue(source, request.column_ids[c]))));
+      }
+      next += columns * kColumnSize;
+    }
+  }
+}
