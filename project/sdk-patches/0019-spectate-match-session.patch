 int XSocket::SendTo(const uint8_t* buf, uint32_t buf_len, uint32_t flags, const XSOCKADDR_IN* to) {
+  std::vector<uint8_t> rewritten;
+  if (type_ == X_SOCK_DGRAM && net::RewriteSessionAnnouncement(buf, buf_len, rewritten)) {
+    buf = rewritten.data();
+  }
   if (!to) {
     return send(native_handle_, reinterpret_cast<const char*>(buf), buf_len, flags);
   }
