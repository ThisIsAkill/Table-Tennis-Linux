 #include <rex/ui/vulkan/util.h>
 
 // Legacy backend compatibility aliases for shared readback controls.
+REXCVAR_DEFINE_DOUBLE(display_brightness, 1.0, "GPU",
+                      "Brightness applied through the guest gamma ramp: 1 leaves the picture as "
+                      "the game sets it, higher values lighten dark and middle tones (white stays "
