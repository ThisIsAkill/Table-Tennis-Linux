+/**
+ * @file        rex/graphics/pipeline/texture/replacement.h
+ * @brief       Texture packs: dump the title's textures and load replacements by content hash
+ *
+ * A texture is identified by a hash of its data in guest memory (with its size and format), so
+ * a replacement follows the picture wherever and whenever the title loads it. Dumping writes
+ * each texture once as a DDS file named after that hash, in the format the host uses for it:
+ * BC1/BC2/BC3 for the title's DXT1/DXT3/DXT5 textures, uncompressed 32-bit for 8_8_8_8 ones (in
+ * the title's own channel order, which the fetch swizzle rearranges as for the original). A
+ * replacement is a DDS file of the same format and the same aspect ratio, at any size (for an HD
+ * pack, usually 2x or 4x), with or without mip levels.
+ *
+ * Settings: texture_pack (load replacements, on by default), texture_pack_dir (default: mods/
+ * textures next to the executable), texture_dump, texture_dump_dir (default: texture_dump next to
+ * the executable).
+ */
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <vector>
+
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics::texture_replacement {
+
+enum class Format : uint8_t { kNone, kBC1, kBC2, kBC3, kRGBA8 };
+
+// The host format a guest format is dumped and replaced in; kNone when not supported.
+Format FormatFor(xenos::TextureFormat guest_format);
+
+// True when texture packs or dumping are on, so callers can skip hashing otherwise.
+bool Active();
+bool DumpEnabled();
+
+// Identity of one texture's base level.
+uint64_t Hash(const uint8_t* guest_data, size_t size, uint32_t width, uint32_t height,
+              xenos::TextureFormat format);
+
+struct Image {
+  Format format = Format::kNone;
+  uint32_t width = 0, height = 0;
+  struct Level {
+    uint32_t width, height;
+    size_t offset, size;  // in data, tightly packed (blocks for BCn, pixels for RGBA8)
+  };
+  std::vector<Level> levels;
+  std::vector<uint8_t> data;
+};
+
+// The replacement for a texture, loaded on first use (nullptr: none, or not usable).
+std::shared_ptr<const Image> Find(uint64_t hash, Format format, uint32_t width, uint32_t height);
+
+// Writes the base level as <dump dir>/<hash>.dds, once per hash. guest_data is the level as
+// stored in guest memory (big-endian, tiled or linear); row_pitch_blocks is the guest pitch.
+void Dump(uint64_t hash, xenos::TextureFormat format, xenos::Endian endian, bool tiled,
+          uint32_t width, uint32_t height, uint32_t row_pitch_bytes, const uint8_t* guest_data,
+          size_t guest_size);
+
+}  // namespace rex::graphics::texture_replacement
