+/**
+ * @file        graphics/pipeline/texture/replacement.cpp
+ * @brief       Texture packs: dump and replacement by content hash (see replacement.h)
+ */
+
+#include <rex/graphics/pipeline/texture/replacement.h>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/graphics/pipeline/texture/conversion.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/hash.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+REXCVAR_DEFINE_BOOL(texture_pack, true, "GPU",
+                    "Load replacement textures (HD texture packs) from texture_pack_dir");
+REXCVAR_DEFINE_STRING(texture_pack_dir, "", "GPU",
+                      "Folder with replacement textures (<hash>.dds); empty: mods/textures next to "
+                      "the executable");
+REXCVAR_DEFINE_BOOL(texture_dump, false, "GPU",
+                    "Write every texture the game uses to texture_dump_dir as <hash>.dds, the "
+                    "starting point for a texture pack");
+REXCVAR_DEFINE_STRING(texture_dump_dir, "", "GPU",
+                      "Folder for texture_dump; empty: texture_dump next to the executable");
+
+namespace rex::graphics::texture_replacement {
+namespace {
+
+constexpr uint32_t kFourCC(char a, char b, char c, char d) {
+  return uint32_t(uint8_t(a)) | uint32_t(uint8_t(b)) << 8 | uint32_t(uint8_t(c)) << 16 |
+         uint32_t(uint8_t(d)) << 24;
+}
+
+std::filesystem::path PackDir() {
+  const std::string dir = REXCVAR_GET(texture_pack_dir);
+  return dir.empty() ? rex::filesystem::GetExecutableFolder() / "mods" / "textures"
+                     : std::filesystem::path(dir);
+}
+
+std::filesystem::path DumpDir() {
+  const std::string dir = REXCVAR_GET(texture_dump_dir);
+  return dir.empty() ? rex::filesystem::GetExecutableFolder() / "texture_dump"
+                     : std::filesystem::path(dir);
+}
+
+std::string HashName(uint64_t hash) {
+  char name[24];
+  std::snprintf(name, sizeof(name), "%016llx", static_cast<unsigned long long>(hash));
+  return name;
+}
+
+struct State {
+  std::mutex mutex;
+  bool scanned = false;
+  std::unordered_map<uint64_t, std::filesystem::path> pack;  // hash -> file
+  std::unordered_map<uint64_t, std::shared_ptr<const Image>> loaded;
+  std::unordered_set<uint64_t> dumped;
+};
+
+State& GetState() {
+  static State state;
+  return state;
+}
+
+// Lists the pack once: every <16 hex digits>.dds file in the pack folder and its subfolders.
+void Scan(State& state) {
+  if (state.scanned) return;
+  state.scanned = true;
+  if (!REXCVAR_GET(texture_pack)) return;
+  std::error_code ec;
+  const auto dir = PackDir();
+  if (!std::filesystem::is_directory(dir, ec)) return;
+  for (auto it = std::filesystem::recursive_directory_iterator(dir, ec);
+       !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    if (!it->is_regular_file(ec)) continue;
+    const auto path = it->path();
+    std::string ext = path.extension().string();
+    std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+    const std::string stem = path.stem().string();
+    if (ext != ".dds" || stem.size() != 16 ||
+        stem.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) {
+      continue;
+    }
+    state.pack[std::strtoull(stem.c_str(), nullptr, 16)] = path;
+  }
+  REXGPU_INFO("Texture pack: {} replacement textures in {}", state.pack.size(), dir.string());
+}
+
+uint32_t BlockSize(Format format) {
+  switch (format) {
+    case Format::kBC1:
+      return 8;
+    case Format::kBC2:
+    case Format::kBC3:
+      return 16;
+    case Format::kRGBA8:
+      return 4;
+    default:
+      return 0;
+  }
+}
+
+bool Compressed(Format format) { return format != Format::kRGBA8; }
+
+size_t LevelSize(Format format, uint32_t width, uint32_t height) {
+  if (Compressed(format)) {
+    return size_t((width + 3) / 4) * ((height + 3) / 4) * BlockSize(format);
+  }
+  return size_t(width) * height * 4;
+}
+
+uint32_t Load32(const uint8_t* p) { return p[0] | p[1] << 8 | p[2] << 16 | uint32_t(p[3]) << 24; }
+void Store32(uint8_t* p, uint32_t v) {
+  for (int i = 0; i < 4; ++i) p[i] = uint8_t(v >> (8 * i));
+}
+
+// Reads a DDS file (legacy or DX10 header) of one of the supported formats.
+std::shared_ptr<Image> ReadDds(const std::filesystem::path& path) {
+  std::ifstream in(path, std::ios::binary);
+  std::vector<uint8_t> file((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+  if (file.size() < 128 || Load32(file.data()) != kFourCC('D', 'D', 'S', ' ')) return nullptr;
+  const uint8_t* h = file.data() + 4;
+  auto image = std::make_shared<Image>();
+  image->height = Load32(h + 8);
+  image->width = Load32(h + 12);
+  uint32_t mips = std::max(1u, Load32(h + 24));
+  const uint32_t pf_flags = Load32(h + 76), fourcc = Load32(h + 80), bits = Load32(h + 84);
+  const uint32_t rmask = Load32(h + 88), bmask = Load32(h + 96);
+  size_t data_offset = 128;
+  bool bgra = false;
+  if (pf_flags & 0x4) {  // DDPF_FOURCC
+    if (fourcc == kFourCC('D', 'X', 'T', '1')) {
+      image->format = Format::kBC1;
+    } else if (fourcc == kFourCC('D', 'X', 'T', '2') || fourcc == kFourCC('D', 'X', 'T', '3')) {
+      image->format = Format::kBC2;
+    } else if (fourcc == kFourCC('D', 'X', 'T', '4') || fourcc == kFourCC('D', 'X', 'T', '5')) {
+      image->format = Format::kBC3;
+    } else if (fourcc == kFourCC('D', 'X', '1', '0') && file.size() >= 148) {
+      data_offset = 148;
+      switch (Load32(file.data() + 128)) {  // DXGI_FORMAT
+        case 71: case 72: image->format = Format::kBC1; break;
+        case 74: case 75: image->format = Format::kBC2; break;
+        case 77: case 78: image->format = Format::kBC3; break;
+        case 28: case 29: image->format = Format::kRGBA8; break;
+        case 87: case 91: image->format = Format::kRGBA8; bgra = true; break;
+        default: break;
+      }
+    }
+  } else if ((pf_flags & 0x40) && bits == 32) {  // DDPF_RGB
+    if (rmask == 0x000000FF) {
+      image->format = Format::kRGBA8;
+    } else if (rmask == 0x00FF0000 && bmask == 0x000000FF) {
+      image->format = Format::kRGBA8;
+      bgra = true;
+    }
+  }
+  if (image->format == Format::kNone || !image->width || !image->height ||
+      image->width > 8192 || image->height > 8192) {
+    return nullptr;
+  }
+  size_t offset = 0;
+  uint32_t w = image->width, hh = image->height;
+  for (uint32_t level = 0; level < mips && level < 14; ++level) {
+    const size_t size = LevelSize(image->format, w, hh);
+    if (data_offset + offset + size > file.size()) break;
+    image->levels.push_back({w, hh, offset, size});
+    offset += size;
+    if (w == 1 && hh == 1) break;
+    w = std::max(1u, w / 2);
+    hh = std::max(1u, hh / 2);
+  }
+  if (image->levels.empty()) return nullptr;
+  image->data.assign(file.begin() + data_offset, file.begin() + data_offset + offset);
+  if (bgra) {
+    for (size_t i = 0; i + 3 < image->data.size(); i += 4) std::swap(image->data[i], image->data[i + 2]);
+  }
+  return image;
+}
+
+void WriteDds(const std::filesystem::path& path, Format format, uint32_t width, uint32_t height,
+              const std::vector<uint8_t>& level0) {
+  uint8_t header[128] = {};
+  Store32(header, kFourCC('D', 'D', 'S', ' '));
+  uint8_t* h = header + 4;
+  Store32(h + 0, 124);
+  // CAPS | HEIGHT | WIDTH | PIXELFORMAT, plus LINEARSIZE or PITCH.
+  Store32(h + 4, 0x1 | 0x2 | 0x4 | 0x1000 | (Compressed(format) ? 0x80000 : 0x8));
+  Store32(h + 8, height);
+  Store32(h + 12, width);
+  Store32(h + 16, Compressed(format) ? uint32_t(level0.size()) : width * 4);
+  Store32(h + 24, 1);
+  Store32(h + 72, 32);
+  if (Compressed(format)) {
+    Store32(h + 76, 0x4);
+    Store32(h + 80, format == Format::kBC1   ? kFourCC('D', 'X', 'T', '1')
+                    : format == Format::kBC2 ? kFourCC('D', 'X', 'T', '3')
+                                             : kFourCC('D', 'X', 'T', '5'));
+  } else {
+    Store32(h + 76, 0x40 | 0x1);  // RGB | ALPHAPIXELS
+    Store32(h + 84, 32);
+    Store32(h + 88, 0x000000FF);
+    Store32(h + 92, 0x0000FF00);
+    Store32(h + 96, 0x00FF0000);
+    Store32(h + 100, 0xFF000000);
+  }
+  Store32(h + 104, 0x1000);  // DDSCAPS_TEXTURE
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  const auto temp = std::filesystem::path(path.string() + ".tmp");
+  {
+    std::ofstream out(temp, std::ios::binary | std::ios::trunc);
+    out.write(reinterpret_cast<const char*>(header), sizeof(header));
+    out.write(reinterpret_cast<const char*>(level0.data()), std::streamsize(level0.size()));
+  }
+  std::filesystem::rename(temp, path, ec);
+}
+
+}  // namespace
+
+Format FormatFor(xenos::TextureFormat guest_format) {
+  switch (guest_format) {
+    case xenos::TextureFormat::k_DXT1:
+      return Format::kBC1;
+    case xenos::TextureFormat::k_DXT2_3:
+      return Format::kBC2;
+    case xenos::TextureFormat::k_DXT4_5:
+      return Format::kBC3;
+    case xenos::TextureFormat::k_8_8_8_8:
+      return Format::kRGBA8;
+    default:
+      return Format::kNone;
+  }
+}
+
+bool DumpEnabled() { return REXCVAR_GET(texture_dump); }
+
+bool Active() {
+  if (DumpEnabled()) return true;
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  Scan(state);
+  return !state.pack.empty();
+}
+
+uint64_t Hash(const uint8_t* guest_data, size_t size, uint32_t width, uint32_t height,
+              xenos::TextureFormat format) {
+  const uint64_t seed = uint64_t(width) << 40 | uint64_t(height) << 16 | uint64_t(format);
+  return XXH3_64bits_withSeed(guest_data, size, seed);
+}
+
+std::shared_ptr<const Image> Find(uint64_t hash, Format format, uint32_t width, uint32_t height) {
+  State& state = GetState();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  Scan(state);
+  auto loaded = state.loaded.find(hash);
+  if (loaded != state.loaded.end()) return loaded->second;
+  auto file = state.pack.find(hash);
+  if (file == state.pack.end()) return nullptr;
+  std::shared_ptr<const Image> image = ReadDds(file->second);
+  const char* problem = nullptr;
+  if (!image) {
+    problem = "not a DDS file in a supported format";
+  } else if (image->format != format) {
+    problem = "different format from the original (keep BC1/BC2/BC3/RGBA8 as dumped)";
+  } else if (image->width < width || image->height < height ||
+             uint64_t(image->width) * height != uint64_t(image->height) * width) {
+    problem = "smaller than the original or a different aspect ratio";
+  }
+  if (problem) {
+    REXGPU_WARN("Texture pack: ignoring {}: {}", file->second.string(), problem);
+    image = nullptr;
+  } else {
+    REXGPU_INFO("Texture pack: {} replaces a {}x{} texture with {}x{} ({} mip levels)",
+                file->second.filename().string(), width, height, image->width, image->height,
+                image->levels.size());
+  }
+  state.loaded[hash] = image;
+  return image;
+}
+
+void Dump(uint64_t hash, xenos::TextureFormat guest_format, xenos::Endian endian, bool tiled,
+          uint32_t width, uint32_t height, uint32_t row_pitch_bytes, const uint8_t* guest_data,
+          size_t guest_size) {
+  const Format format = FormatFor(guest_format);
+  if (format == Format::kNone) return;
+  State& state = GetState();
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (!state.dumped.insert(hash).second) return;
+  }
+  const uint32_t block = Compressed(format) ? 4 : 1;
+  const uint32_t bytes_per_block = BlockSize(format);
+  const uint32_t blocks_x = (width + block - 1) / block, blocks_y = (height + block - 1) / block;
+  const uint32_t bpb_log2 = bytes_per_block == 4 ? 2 : bytes_per_block == 8 ? 3 : 4;
+  const uint32_t pitch_blocks = std::max(blocks_x, row_pitch_bytes / bytes_per_block);
+  std::vector<uint8_t> level(size_t(blocks_x) * blocks_y * bytes_per_block);
+  for (uint32_t y = 0; y < blocks_y; ++y) {
+    for (uint32_t x = 0; x < blocks_x; ++x) {
+      const size_t source =
+          tiled ? size_t(texture_util::GetTiledOffset2D(int32_t(x), int32_t(y), pitch_blocks,
+                                                        bpb_log2))
+                : size_t(y) * row_pitch_bytes + size_t(x) * bytes_per_block;
+      if (source + bytes_per_block > guest_size) continue;
+      texture_conversion::CopySwapBlock(
+          endian, level.data() + (size_t(y) * blocks_x + x) * bytes_per_block,
+          guest_data + source, bytes_per_block);
+    }
+  }
+  const auto path = DumpDir() / (HashName(hash) + ".dds");
+  WriteDds(path, format, width, height, level);
+  REXGPU_INFO("Texture dump: {}x{} texture -> {}", width, height, path.filename().string());
+}
+
+}  // namespace rex::graphics::texture_replacement
