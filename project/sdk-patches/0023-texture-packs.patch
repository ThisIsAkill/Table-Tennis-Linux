+bool VulkanTextureCache::ApplyTextureReplacement(VulkanTexture& texture) {
+  if (!texture_replacement::Active()) return false;
+  const TextureKey key = texture.key();
+  const texture_replacement::Format format = texture_replacement::FormatFor(key.format);
+  if (format == texture_replacement::Format::kNone ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+      key.scaled_resolve || key.signed_separate) {
+    return false;
+  }
+  // Replacements are uploaded in the host format the original would use; skip devices that
+  // store the format differently (for example without BC support).
+  VkFormat expected = VK_FORMAT_UNDEFINED;
+  switch (format) {
+    case texture_replacement::Format::kBC1:
+      expected = VK_FORMAT_BC1_RGBA_UNORM_BLOCK;
+      break;
+    case texture_replacement::Format::kBC2:
+      expected = VK_FORMAT_BC2_UNORM_BLOCK;
+      break;
+    case texture_replacement::Format::kBC3:
+      expected = VK_FORMAT_BC3_UNORM_BLOCK;
+      break;
+    default:
+      expected = VK_FORMAT_R8G8B8A8_UNORM;
+      break;
+  }
+  if (GetHostFormatPair(key).format_unsigned.format != expected) return false;
+  const uint32_t size = texture.GetGuestBaseSize();
+  const uint32_t address = key.base_page << 12;
+  if (!size || uint64_t(address) + size > SharedMemory::kBufferSize) return false;
+  const uint8_t* data = shared_memory().memory().TranslatePhysical<const uint8_t*>(address);
+  const uint32_t width = key.GetWidth(), height = key.GetHeight();
+  const uint64_t hash = texture_replacement::Hash(data, size, width, height, key.format);
+  if (texture_replacement::DumpEnabled()) {
+    texture_replacement::Dump(hash, key.format, key.endianness, bool(key.tiled), width, height,
+                              texture.guest_layout().base.row_pitch_bytes, data, size);
+  }
+  std::shared_ptr<const texture_replacement::Image> image =
+      texture_replacement::Find(hash, format, width, height);
+  std::shared_ptr<ReplacementImage> replacement =
+      image ? GetReplacementImage(hash, expected, *image) : nullptr;
+  texture.SetReplacement(replacement);
+  return bool(replacement);
+}
