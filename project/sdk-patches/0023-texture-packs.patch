+std::shared_ptr<VulkanTextureCache::ReplacementImage> VulkanTextureCache::GetReplacementImage(
+    uint64_t hash, VkFormat format, const texture_replacement::Image& source) {
+  auto it = replacement_images_.find(hash);
+  if (it != replacement_images_.end()) return it->second;
+  // Created once per hash; a failure is remembered too, so it is not retried every load.
+  std::shared_ptr<ReplacementImage>& replacement = replacement_images_[hash];
+
+  constexpr size_t kUploadPageSize = size_t(16) << 20;
+  for (const auto& level : source.levels) {
+    if (level.size > kUploadPageSize) {
+      REXGPU_WARN("Texture pack: a {}x{} level is too large to upload (16 MB per level)",
+                  level.width, level.height);
+      return nullptr;
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  if (!replacement_upload_pool_) {
+    replacement_upload_pool_ = std::make_unique<ui::vulkan::VulkanUploadBufferPool>(
+        vulkan_device, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, kUploadPageSize);
+  }
+
+  VkImageCreateInfo image_create_info = {};
+  image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_create_info.imageType = VK_IMAGE_TYPE_2D;
+  image_create_info.format = format;
+  image_create_info.extent = {source.width, source.height, 1};
+  image_create_info.mipLevels = uint32_t(source.levels.size());
+  image_create_info.arrayLayers = 1;
+  image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_create_info.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  VmaAllocationCreateInfo allocation_create_info = {};
+  allocation_create_info.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE;
+  auto created = std::make_shared<ReplacementImage>();
+  created->format = format;
+  if (vmaCreateImage(vma_allocator_, &image_create_info, &allocation_create_info, &created->image,
+                     &created->allocation, nullptr) != VK_SUCCESS) {
+    REXGPU_WARN("Texture pack: could not create a {}x{} image", source.width, source.height);
+    return nullptr;
+  }
+
+  // Upload every level, then leave the image ready for sampling; it is never written again.
+  VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  command_processor_.PushImageMemoryBarrier(
+      created->image, range, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+      VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  for (uint32_t level = 0; level < uint32_t(source.levels.size()); ++level) {
+    const auto& source_level = source.levels[level];
+    VkBuffer buffer;
+    VkDeviceSize offset;
+    uint8_t* mapping =
+        replacement_upload_pool_->Request(submission, source_level.size, 16, buffer, offset);
+    if (!mapping) {
+      REXGPU_WARN("Texture pack: no upload buffer for a {}x{} level", source_level.width,
+                  source_level.height);
+      break;
+    }
+    std::memcpy(mapping, source.data.data() + source_level.offset, source_level.size);
+    VkBufferImageCopy region = {};
+    region.bufferOffset = offset;
+    region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.imageSubresource.mipLevel = level;
+    region.imageSubresource.layerCount = 1;
+    region.imageExtent = {source_level.width, source_level.height, 1};
+    command_buffer.CmdVkCopyBufferToImage(buffer, created->image,
+                                          VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  }
+  command_processor_.PushImageMemoryBarrier(
+      created->image, range, VK_PIPELINE_STAGE_TRANSFER_BIT, guest_shader_pipeline_stages_,
+      VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED,
+      false);
+  replacement = std::move(created);
+  return replacement;
+}
