+// --- Online play ----------------------------------------------------------------------------
+// Client of server/ttlink_server.py. All messages start with "TTV1" and a type byte; fields
+// are big-endian. Server messages: HELLO/WELCOME (join a room, get an id, a room address and a
+// token), MEMBERS (the other players: id, room address, token, public and local endpoint,
+// name), KEEPALIVE/STATUS, DATA/RELAYED (datagrams relayed or broadcast to the room), BYE,
+// ERROR. Between players: PUNCH/PUNCH_ACK (open a direct path through both NATs) and DIRECT
+// (a datagram sent straight to the other player).
+namespace {
+constexpr uint8_t kOnlineMagic[4] = {'T', 'T', 'V', '1'};
+enum OnlineMessage : uint8_t {
+  kHello = 1, kWelcome, kMembers, kKeepAlive, kStatus, kData, kRelayed, kBye, kPunch,
+  kPunchAck, kDirect, kError,
+};
+constexpr uint16_t kDefaultServerPort = 27360;
+constexpr uint32_t kOnlineBroadcast = 0xFFFFFFFF;
+constexpr size_t kMaxOnlinePayload = 1400;
+
+using OnlineClock = std::chrono::steady_clock;
+
+struct Writer {
+  std::vector<uint8_t> data;
+  explicit Writer(uint8_t type) {
+    data.assign(kOnlineMagic, kOnlineMagic + 4);
+    data.push_back(type);
+  }
+  void u8(uint8_t v) { data.push_back(v); }
+  void u16(uint16_t v) { u8(uint8_t(v >> 8)); u8(uint8_t(v)); }
+  void u32(uint32_t v) { u16(uint16_t(v >> 16)); u16(uint16_t(v)); }
+  void u64(uint64_t v) { u32(uint32_t(v >> 32)); u32(uint32_t(v)); }
+  void str(const std::string& v) {
+    const size_t n = std::min<size_t>(v.size(), 255);
+    u8(uint8_t(n));
+    data.insert(data.end(), v.begin(), v.begin() + n);
+  }
+  void bytes(const uint8_t* p, size_t n) { data.insert(data.end(), p, p + n); }
+};
+
+struct Reader {
+  const uint8_t* p;
+  size_t n;
+  size_t pos = 0;
+  bool ok = true;
+  bool need(size_t k) {
+    if (pos + k > n) ok = false;
+    return ok;
+  }
+  uint8_t u8() { return need(1) ? p[pos++] : 0; }
+  uint16_t u16() { uint16_t hi = u8(); return uint16_t((hi << 8) | u8()); }
+  uint32_t u32() { uint32_t hi = u16(); return (hi << 16) | u16(); }
+  uint64_t u64() { uint64_t hi = u32(); return (hi << 32) | u32(); }
+  std::string str() {
+    const size_t k = u8();
+    if (!need(k)) return {};
+    std::string v(reinterpret_cast<const char*>(p + pos), k);
+    pos += k;
+    return v;
+  }
+};
+
+sockaddr_in Endpoint(uint32_t ip, uint16_t port) {
+  sockaddr_in a{};
+  a.sin_family = AF_INET;
+  a.sin_addr.s_addr = htonl(ip);
+  a.sin_port = htons(port);
+  return a;
+}
+
+bool SameEndpoint(const sockaddr_in& a, const sockaddr_in& b) {
+  return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port;
+}
+
+// Sockets the title bound, by guest port, to hand them the datagrams that arrive online.
+std::mutex bound_mutex;
+std::vector<std::pair<uint16_t, XSocket*>> bound_sockets;
+
+class OnlineClient {
+ public:
+  static OnlineClient& Get() {
+    static OnlineClient* client = new OnlineClient();  // lives for the whole process
+    return *client;
+  }
+
+  void Configure(const std::string& mode, const std::string& room) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (mode != mode_ || room != room_) {
+      state_ = mode == "public" || mode == "room" ? "CONNECTING" : "OFF";
+    }
+    mode_ = mode;
+    room_ = room;
+  }
+
+  bool Enabled() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return mode_ == "public" || mode_ == "room";
+  }
+
+  uint32_t Address() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return welcomed_ ? vip_ : 0;
+  }
+
+  OnlineStatus Status() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    OnlineStatus status;
+    status.mode = mode_;
+    status.room = mode_ == "room" ? room_ : "";
+    status.state = state_;
+    status.connected = welcomed_;
+    status.room_players = welcomed_ ? std::max(room_players_, int(peers_.size()) + 1) : 0;
+    status.players_online = players_online_;
+    for (const auto& peer : peers_) {
+      (peer.direct ? status.direct_peers : status.relayed_peers)++;
+    }
+    return status;
+  }
+
+  // A datagram from the title: to a room member (directly or relayed) or to the whole room.
+  void Send(uint32_t dest, uint16_t src_port, uint16_t dst_port, const uint8_t* data, size_t len) {
+    if (len > kMaxOnlinePayload) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!welcomed_ || fd_ < 0) return;
+    const bool broadcast = dest == kOnlineBroadcast || (dest & 0xFF) == 0xFF;
+    if (!broadcast) {
+      for (const auto& peer : peers_) {
+        if (peer.vip != dest || !peer.direct || relay_only_) continue;
+        Writer w(kDirect);
+        w.u32(id_);
+        w.u64(token_);
+        w.u16(src_port);
+        w.u16(dst_port);
+        w.bytes(data, len);
+        SendRaw(peer.direct_addr, w.data);
+        return;
+      }
+    }
+    Writer w(kData);
+    w.u32(id_);
+    w.u64(token_);
+    w.u32(broadcast ? kOnlineBroadcast : dest);
+    w.u16(src_port);
+    w.u16(dst_port);
+    w.bytes(data, len);
+    SendRaw(server_, w.data);
+  }
+
+ private:
+  struct Peer {
+    uint32_t id = 0;
+    uint32_t vip = 0;
+    uint64_t token = 0;
+    std::string name;
+    sockaddr_in public_addr{};
+    sockaddr_in local_addr{};
+    sockaddr_in direct_addr{};
+    bool direct = false;
+    OnlineClock::time_point seen;           // first listed
+    OnlineClock::time_point last_punch{};
+    OnlineClock::time_point last_direct{};  // last packet received directly
+  };
+
+  OnlineClient() {
+    mode_ = REXCVAR_GET(online);
+    room_ = REXCVAR_GET(room_code);
+    std::thread([this] { Run(); }).detach();
+  }
+
+  void SendRaw(const sockaddr_in& to, const std::vector<uint8_t>& data) {
+    sendto(fd_, reinterpret_cast<const char*>(data.data()), data.size(), 0,
+           reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+  }
+
+  // Reads the online_server setting; false when none is set or it cannot be resolved.
+  bool ResolveServer() {
+    std::string text = REXCVAR_GET(online_server);
+    if (text.empty()) return false;
+    uint16_t port = kDefaultServerPort;
+    const size_t colon = text.rfind(':');
+    if (colon != std::string::npos) {
+      port = uint16_t(std::atoi(text.c_str() + colon + 1));
+      text.resize(colon);
+    }
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    addrinfo* result = nullptr;
+    if (getaddrinfo(text.c_str(), nullptr, &hints, &result) != 0 || !result) return false;
+    server_ = *reinterpret_cast<sockaddr_in*>(result->ai_addr);
+    server_.sin_port = htons(port);
+    freeaddrinfo(result);
+    return true;
+  }
+
+  void Disconnect() {
+    if (fd_ >= 0) {
+      if (welcomed_) {
+        Writer w(kBye);
+        w.u32(id_);
+        w.u64(token_);
+        SendRaw(server_, w.data);
+      }
+      rex::net::socket_close(fd_);
+    }
+    fd_ = -1;
+    welcomed_ = false;
+    resolved_ = false;
+    peers_.clear();
+    room_players_ = 0;
+  }
+
+  void Run() {
+    std::string active_mode, active_room, active_server;
+    uint8_t buffer[2048];
+    while (true) {
+      std::unique_lock<std::mutex> lock(mutex_);
+      const auto now = OnlineClock::now();
+      const bool on = mode_ == "public" || mode_ == "room";
+      const std::string server = REXCVAR_GET(online_server);
+      if (mode_ != active_mode || room_ != active_room || server != active_server) {
+        if (!active_mode.empty() && fd_ >= 0) {
+          REXKRNL_INFO("Online: settings changed ({} {}), reconnecting", mode_, room_);
+        }
+        Disconnect();
+        active_mode = mode_;
+        active_room = room_;
+        active_server = server;
+        hello_nonce_ = (uint64_t(std::random_device{}()) << 32) | std::random_device{}();
+      }
+      relay_only_ = REXCVAR_GET(online_relay_only);
+      if (!on) {
+        state_ = "OFF";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        continue;
+      }
+      if (server.empty()) {
+        state_ = "NO SERVER SET";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        continue;
+      }
+      if (mode_ == "room" && !ValidRoom(room_)) {
+        state_ = "ENTER A ROOM CODE";
+        lock.unlock();
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        continue;
+      }
+      if (!resolved_) {
+        if (now < next_resolve_) {
+          lock.unlock();
+          std::this_thread::sleep_for(std::chrono::milliseconds(200));
+          continue;
+        }
+        resolved_ = ResolveServer();
+        if (!resolved_) {
+          state_ = "SERVER NOT FOUND";
+          next_resolve_ = now + std::chrono::seconds(10);
+          continue;
+        }
+      }
+      if (fd_ < 0) {
+        fd_ = int(::socket(AF_INET, SOCK_DGRAM, 0));
+        sockaddr_in local = Endpoint(BindLocalAddress() ? BaseAddress() : INADDR_ANY, 0);
+        bind(fd_, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+        socklen_t len = sizeof(local);
+        getsockname(fd_, reinterpret_cast<sockaddr*>(&local), &len);
+        local_port_ = ntohs(local.sin_port);
+        last_server_ = now;
+        state_ = "CONNECTING";
+      }
+      if (!welcomed_ && now - last_hello_ > std::chrono::seconds(1)) {
+        last_hello_ = now;
+        Writer w(kHello);
+        w.u8(1);  // protocol version
+        w.u64(hello_nonce_);
+        std::string name = rex::cvar::GetFlagByName("user_name");
+        w.str(name.empty() ? "Player" : name);
+        w.str(mode_ == "room" ? room_ : "");
+        w.u32(BaseAddress());
+        w.u16(local_port_);
+        SendRaw(server_, w.data);
+        if (now - last_server_ > std::chrono::seconds(10)) state_ = "NO ANSWER FROM SERVER";
+      }
+      if (welcomed_) {
+        if (now - last_keepalive_ > std::chrono::seconds(3)) {
+          last_keepalive_ = now;
+          Writer w(kKeepAlive);
+          w.u32(id_);
+          w.u64(token_);
+          SendRaw(server_, w.data);
+        }
+        if (now - last_server_ > std::chrono::seconds(15)) {
+          REXKRNL_WARN("Online: lost the server, reconnecting");
+          welcomed_ = false;
+          peers_.clear();
+          state_ = "RECONNECTING";
+        }
+        Punch(now);
+      }
+      const int fd = fd_;
+      lock.unlock();
+
+      pollfd poll_fd{fd, POLLIN, 0};
+      if (poll(&poll_fd, 1, 50) <= 0) continue;
+      while (true) {
+        sockaddr_in from{};
+        socklen_t from_len = sizeof(from);
+        const ssize_t n = recvfrom(fd, reinterpret_cast<char*>(buffer), sizeof(buffer),
+                                   MSG_DONTWAIT, reinterpret_cast<sockaddr*>(&from), &from_len);
+        if (n < 5) break;
+        if (std::memcmp(buffer, kOnlineMagic, 4) != 0) continue;
+        Handle(buffer[4], buffer + 5, size_t(n - 5), from);
+      }
+    }
+  }
+
+  static bool ValidRoom(const std::string& room) {
+    static const char* alphabet = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+    if (room.size() != 6) return false;
+    for (char c : room) {
+      if (!std::strchr(alphabet, c)) return false;
+    }
+    return true;
+  }
+
+  // Opens and keeps direct paths: every new peer gets punches to its public and local
+  // endpoints twice a second for 15 s (then every 5 s); a direct peer gets one every 5 s to
+  // keep the NAT mappings open, and falls back to the relay after 15 s of silence.
+  void Punch(OnlineClock::time_point now) {
+    if (relay_only_) return;
+    for (auto& peer : peers_) {
+      if (peer.direct && now - peer.last_direct > std::chrono::seconds(15)) {
+        REXKRNL_INFO("Online: direct path to {} lost, using the server", peer.name);
+        peer.direct = false;
+      }
+      const auto interval = peer.direct || now - peer.seen > std::chrono::seconds(15)
+                                ? std::chrono::milliseconds(5000)
+                                : std::chrono::milliseconds(500);
+      if (now - peer.last_punch < interval) continue;
+      peer.last_punch = now;
+      Writer w(kPunch);
+      w.u32(id_);
+      w.u64(token_);
+      w.u32(peer.id);
+      if (peer.direct) {
+        SendRaw(peer.direct_addr, w.data);
+      } else {
+        SendRaw(peer.public_addr, w.data);
+        if (peer.local_addr.sin_port && !SameEndpoint(peer.local_addr, peer.public_addr)) {
+          SendRaw(peer.local_addr, w.data);
+        }
+      }
+    }
+  }
+
+  Peer* FindPeer(uint32_t id, uint64_t token) {
+    for (auto& peer : peers_) {
+      if (peer.id == id && peer.token == token) return &peer;
+    }
+    return nullptr;
+  }
+
+  void MarkDirect(Peer* peer, const sockaddr_in& from) {
+    if (!peer->direct || !SameEndpoint(peer->direct_addr, from)) {
+      REXKRNL_INFO("Online: direct connection to {} ({}:{})", peer->name,
+                   FormatAddress(ntohl(from.sin_addr.s_addr)), ntohs(from.sin_port));
+    }
+    peer->direct = true;
+    peer->direct_addr = from;
+    peer->last_direct = OnlineClock::now();
+  }
+
+  void Handle(uint8_t type, const uint8_t* body, size_t len, const sockaddr_in& from) {
+    Reader r{body, len};
+    uint32_t deliver_from = 0;
+    uint16_t src_port = 0, dst_port = 0;
+    const uint8_t* payload = nullptr;
+    size_t payload_len = 0;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      const bool from_server = SameEndpoint(from, server_);
+      if (from_server) last_server_ = OnlineClock::now();
+      switch (type) {
+        case kWelcome: {
+          if (!from_server) return;
+          id_ = r.u32();
+          vip_ = r.u32();
+          token_ = r.u64();
+          const std::string room = r.str();
+          const uint32_t public_ip = r.u32();
+          const uint16_t public_port = r.u16();
+          if (!r.ok) return;
+          if (!welcomed_) {
+            REXKRNL_INFO("Online: joined {} as {} (seen as {}:{})",
+                         room.empty() ? "the public room" : "room " + room, FormatAddress(vip_),
+                         FormatAddress(public_ip), public_port);
+          }
+          welcomed_ = true;
+          state_ = "CONNECTED";
+          return;
+        }
+        case kMembers: {
+          if (!from_server || !welcomed_) return;
+          const uint16_t total = r.u16();
+          const uint16_t count = r.u16();
+          std::vector<Peer> listed;
+          for (uint16_t i = 0; i < count && r.ok; ++i) {
+            Peer peer;
+            peer.id = r.u32();
+            peer.vip = r.u32();
+            peer.token = r.u64();
+            const uint32_t pub_ip = r.u32();
+            const uint16_t pub_port = r.u16();
+            const uint32_t local_ip = r.u32();
+            const uint16_t local_port = r.u16();
+            peer.name = r.str();
+            peer.public_addr = Endpoint(pub_ip, pub_port);
+            peer.local_addr = Endpoint(local_ip, local_port);
+            listed.push_back(peer);
+          }
+          if (!r.ok) return;
+          room_players_ = total + 1;
+          // One MEMBERS message lists the whole room when it is small; larger rooms arrive in
+          // parts and only add players (the periodic refresh drops those who left).
+          const bool complete = count == total;
+          std::vector<Peer> next;
+          for (auto& peer : listed) {
+            auto it = std::find_if(peers_.begin(), peers_.end(),
+                                   [&](const Peer& p) { return p.id == peer.id; });
+            if (it != peers_.end()) {
+              it->public_addr = peer.public_addr;
+              it->local_addr = peer.local_addr;
+              next.push_back(*it);
+            } else {
+              peer.seen = OnlineClock::now();
+              REXKRNL_INFO("Online: {} is in the room ({})", peer.name, FormatAddress(peer.vip));
+              next.push_back(peer);
+            }
+          }
+          if (!complete) {
