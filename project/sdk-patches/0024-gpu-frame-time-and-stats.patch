+void VulkanCommandProcessor::GpuTimeBeginCommandBuffer(VkCommandBuffer command_buffer) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE && !gpu_time_unavailable_) {
+    VkPhysicalDeviceProperties properties;
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        vulkan_device->physical_device(), &properties);
+    if (!properties.limits.timestampComputeAndGraphics || properties.limits.timestampPeriod <= 0) {
+      gpu_time_unavailable_ = true;
+      return;
+    }
+    gpu_time_ns_per_tick_ = properties.limits.timestampPeriod;
+    VkQueryPoolCreateInfo create_info = {};
+    create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    create_info.queryCount = kGpuTimeSlots * 2;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &create_info, nullptr,
+                              &gpu_time_query_pool_) != VK_SUCCESS) {
+      gpu_time_unavailable_ = true;
+      gpu_time_query_pool_ = VK_NULL_HANDLE;
+      return;
+    }
+    gpu_time_window_start_ = std::chrono::steady_clock::now();
+  }
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE) return;
+  // A slot is reused only after its earlier submission was read back (or dropped).
+  if (gpu_time_pending_.size() >= kGpuTimeSlots) gpu_time_pending_.pop_front();
+  const uint32_t slot = uint32_t(GetCurrentSubmission() % kGpuTimeSlots);
+  dfn.vkCmdResetQueryPool(command_buffer, gpu_time_query_pool_, slot * 2, 2);
+  dfn.vkCmdWriteTimestamp(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, gpu_time_query_pool_,
+                          slot * 2);
+}
+
+void VulkanCommandProcessor::GpuTimeEndCommandBuffer(VkCommandBuffer command_buffer) {
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE) return;
+  const uint32_t slot = uint32_t(GetCurrentSubmission() % kGpuTimeSlots);
+  GetVulkanDevice()->functions().vkCmdWriteTimestamp(
+      command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_time_query_pool_, slot * 2 + 1);
+  gpu_time_pending_.emplace_back(GetCurrentSubmission(), slot);
+}
+
+void VulkanCommandProcessor::GpuTimeCollect() {
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE) return;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  while (!gpu_time_pending_.empty() && gpu_time_pending_.front().first <= submission_completed_) {
+    const uint32_t slot = gpu_time_pending_.front().second;
+    gpu_time_pending_.pop_front();
+    uint64_t ticks[2];
+    if (vulkan_device->functions().vkGetQueryPoolResults(
+            vulkan_device->device(), gpu_time_query_pool_, slot * 2, 2, sizeof(ticks), ticks,
+            sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+        ticks[1] > ticks[0]) {
+      gpu_time_busy_ns_ += uint64_t(double(ticks[1] - ticks[0]) * gpu_time_ns_per_tick_);
+    }
+  }
+  ++gpu_time_frames_;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - gpu_time_window_start_ >= std::chrono::seconds(1) && gpu_time_frames_) {
+    rex::system::gpu_frame_time::Report(double(gpu_time_busy_ns_) / 1e6 / gpu_time_frames_);
+    gpu_time_busy_ns_ = 0;
+    gpu_time_frames_ = 0;
+    gpu_time_window_start_ = now;
+  }
+}
