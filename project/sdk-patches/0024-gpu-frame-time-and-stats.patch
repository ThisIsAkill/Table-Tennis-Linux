diff --git a/src/system/gpu_frame_time.cpp b/src/system/gpu_frame_time.cpp
new file mode 100644
index 0000000..0d82018
--- /dev/null
+++ b/src/system/gpu_frame_time.cpp
@@ -0,0 +1,19 @@
+/**
+ * @file        system/gpu_frame_time.cpp
+ * @brief       GPU time per frame, shared between the GPU backend and the title (see header)
+ */
+
+#include <rex/system/gpu_frame_time.h>
+
+#include <atomic>
+
+namespace rex::system::gpu_frame_time {
+namespace {
+std::atomic<double> g_last_ms{0.0};
+}  // namespace
+
+double LastMs() { return g_last_ms.load(std::memory_order_relaxed); }
+
+void Report(double ms_per_frame) { g_last_ms.store(ms_per_frame, std::memory_order_relaxed); }
+
+}  // namespace rex::system::gpu_frame_time
