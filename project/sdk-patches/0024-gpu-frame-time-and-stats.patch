index 0000000..039fe5d
--- /dev/null
+++ b/include/rex/graphics/gpu_stats.h
@@ -0,0 +1,45 @@
+/**
+ * @file        rex/graphics/gpu_stats.h
+ * @brief       Per-frame GPU work counters (TT_GPU_STATS=1 logs them every two seconds)
+ *
+ * Counts the work the emulated GPU turns into host work: draws, render target ownership transfers
+ * (EDRAM tiles copied between host render targets), resolves (EDRAM to memory) and texture loads
+ * (memory to host images), with their sizes in host pixels or bytes, so the cost of a higher draw
+ * resolution scale can be attributed.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace rex::graphics::gpu_stats {
+
+inline bool Enabled() {
+  static const bool enabled = [] {
+    const char* v = std::getenv("TT_GPU_STATS");
+    return v && *v && *v != '0';
+  }();
+  return enabled;
+}
+
+struct Counters {
+  std::atomic<uint64_t> frames{0};
+  std::atomic<uint64_t> draws{0};
+  std::atomic<uint64_t> transfers{0}, transfer_samples{0};
+  std::atomic<uint64_t> resolves{0}, resolve_pixels{0};
+  std::atomic<uint64_t> texture_loads{0}, texture_load_bytes{0};
+  std::atomic<uint64_t> scaled_texture_loads{0}, scaled_texture_load_bytes{0};
+  std::atomic<uint64_t> render_passes{0};
+};
+
+inline Counters& Get() {
+  static Counters counters;
+  return counters;
+}
+
+inline void Add(std::atomic<uint64_t>& counter, uint64_t value = 1) {
+  if (Enabled()) counter.fetch_add(value, std::memory_order_relaxed);
+}
+
+}  // namespace rex::graphics::gpu_stats
