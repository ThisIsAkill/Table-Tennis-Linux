+++ b/include/rex/system/gpu_frame_time.h
@@ -0,0 +1,19 @@
+/**
+ * @file        rex/system/gpu_frame_time.h
+ * @brief       How long the host GPU spends on each emulated frame
+ *
+ * The Vulkan backend times every submission with timestamp queries and reports the average GPU
+ * time per presented frame about once a second. Titles can use it to choose a draw resolution
+ * scale the machine can afford. Zero until the first measurement (or where timestamps are not
+ * supported).
+ */
+#pragma once
+
+namespace rex::system::gpu_frame_time {
+
+// Average GPU milliseconds per frame over the last measurement window (about one second).
+double LastMs();
+// Called by the GPU backend.
+void Report(double ms_per_frame);
+
+}  // namespace rex::system::gpu_frame_time
