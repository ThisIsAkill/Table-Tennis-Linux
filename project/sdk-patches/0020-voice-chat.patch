   return true;
 }
 
+// --- System Link voice transport --------------------------------------------------------------
+// Online voice rides the relay (OnlineClient::SendVoiceToRoom); System Link peers are on the LAN,
+// so voice goes straight to them over a dedicated UDP socket on kVoiceUdpPort. The peers are the
+// secure associations registered under the current session key.
+namespace {
+constexpr uint16_t kVoiceUdpPort = 0xADA0;  // 44448
+constexpr uint8_t kVoiceUdpMagic[4] = {'T', 'T', 'V', 'C'};
+std::mutex voice_socket_mutex;
+int voice_fd = -1;
+std::thread voice_recv_thread;
+std::atomic<bool> voice_recv_run{false};
+
+void VoiceRecvLoop() {
+  uint8_t buf[2048];
+  while (voice_recv_run.load()) {
+    sockaddr_in from{};
+    socklen_t from_len = sizeof(from);
+    const ssize_t n = recvfrom(voice_fd, reinterpret_cast<char*>(buf), sizeof(buf), 0,
+                               reinterpret_cast<sockaddr*>(&from), &from_len);
+    if (n > 4 && std::memcmp(buf, kVoiceUdpMagic, 4) == 0) {
+      rex::system::voice::OnIncomingFrame(ntohl(from.sin_addr.s_addr), buf + 4, size_t(n - 4));
+    }
+  }
+}
+
+// Opens the voice socket once, bound to our own address, so two instances on one machine (the
+// System Link loopback test) can share the port on different loopback addresses. A 100 ms receive
+// timeout lets the thread notice shutdown.
+void EnsureVoiceSocket() {
+  std::lock_guard<std::mutex> lock(voice_socket_mutex);
+  if (voice_fd >= 0) return;
+  int fd = int(::socket(AF_INET, SOCK_DGRAM, 0));
+  if (fd < 0) return;
+  int one = 1;
+  setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+  timeval tv{0, 100000};
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&tv), sizeof(tv));
+  sockaddr_in local{};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = htonl(LocalAddress());
+  local.sin_port = htons(kVoiceUdpPort);
+  if (bind(fd, reinterpret_cast<sockaddr*>(&local), sizeof(local)) < 0) {
+    rex::net::socket_close(fd);
+    return;
+  }
+  voice_fd = fd;
+  voice_recv_run.store(true);
+  voice_recv_thread = std::thread(VoiceRecvLoop);
+  REXKRNL_INFO("Voice: System Link socket on {}:{}", FormatAddress(LocalAddress()), kVoiceUdpPort);
+}
+
+// Real addresses of the peers in the current System Link session.
+std::vector<uint32_t> CurrentSessionPeers() {
+  std::vector<uint32_t> result;
+  uint8_t kid[8];
+  if (!CurrentSessionKey(kid)) return result;
+  std::lock_guard<std::mutex> lock(association_mutex);
+  for (const auto& a : associations) {
+    if (std::memcmp(a.kid.data(), kid, 8) == 0) result.push_back(a.real);
+  }
+  return result;
+}
+
+void SendVoiceSystemLink(const uint8_t* frame, size_t bytes) {
+  const std::vector<uint32_t> peers = CurrentSessionPeers();
+  if (peers.empty()) return;
+  EnsureVoiceSocket();
+  if (voice_fd < 0) return;
+  std::vector<uint8_t> packet(4 + bytes);
+  std::memcpy(packet.data(), kVoiceUdpMagic, 4);
+  std::memcpy(packet.data() + 4, frame, bytes);
+  for (uint32_t real : peers) {
+    sockaddr_in to{};
+    to.sin_family = AF_INET;
+    to.sin_addr.s_addr = htonl(real);
+    to.sin_port = htons(kVoiceUdpPort);
+    sendto(voice_fd, reinterpret_cast<const char*>(packet.data()), packet.size(), 0,
+           reinterpret_cast<sockaddr*>(&to), sizeof(to));
+  }
+}
