@@ -0,0 +1,300 @@
+// voice_chat.cpp - see rex/system/voice_chat.h.
+
+#include <rex/system/voice_chat.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <SDL3/SDL.h>
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+REXCVAR_DEFINE_BOOL(voice_chat, true, "Voice", "Headset voice chat in multiplayer matches");
+REXCVAR_DEFINE_INT32(voice_mic_gate, 600, "Voice",
+                     "Microphone noise gate: frames quieter than this (0-32767 RMS) are not sent");
+REXCVAR_DEFINE_BOOL(voice_test, false, "Voice",
+                    "Test mode: send a generated tone instead of the mic and write played audio "
+                    "to voice-in.wav (for checking the path without audio hardware)");
+REXCVAR_DEFINE_BOOL(voice_monitor, false, "Voice",
+                    "Loop your own microphone back to your speakers so you can test the mic "
+                    "without a match (use headphones to avoid feedback)");
+
+namespace rex::system::voice {
+namespace {
+
+std::atomic<bool> g_started{false};
+std::atomic<bool> g_in_session{false};
+std::atomic<SessionQueryFn> g_session_query{nullptr};
+std::atomic<SendFrameFn> g_sender{nullptr};
+std::atomic<bool> g_local_talking{false};
+std::atomic<int64_t> g_last_remote_ns{0};
+
+SDL_AudioStream* g_capture = nullptr;   // mic (nullptr in test mode or with no device)
+SDL_AudioStream* g_playback = nullptr;  // speaker/headset
+std::thread g_capture_thread;
+std::atomic<bool> g_run{false};
+
+// Test mode: tone phase and a WAV of everything played.
+double g_tone_phase = 0.0;
+std::FILE* g_wav = nullptr;
+uint32_t g_wav_bytes = 0;
+std::mutex g_wav_mutex;
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+SDL_AudioSpec FrameSpec() {
+  SDL_AudioSpec spec{};
+  spec.format = SDL_AUDIO_S16;
+  spec.channels = 1;
+  spec.freq = kSampleRate;
+  return spec;
+}
+
+// --- test-mode WAV ----------------------------------------------------------------------------
+void WavOpen() {
+  g_wav = std::fopen("voice-in.wav", "wb");
+  if (!g_wav) return;
+  const uint8_t header[44] = {'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ',
+                              16, 0, 0, 0, 1, 0, 1, 0, 0x80, 0x3E, 0, 0, 0, 0x7D, 0, 0, 2, 0, 16, 0,
+                              'd', 'a', 't', 'a', 0, 0, 0, 0};  // 16 kHz mono S16
+  std::fwrite(header, 1, sizeof(header), g_wav);
+  g_wav_bytes = 0;
+}
+void WavWrite(const uint8_t* pcm, size_t bytes) {
+  std::lock_guard<std::mutex> lock(g_wav_mutex);
+  if (!g_wav) return;
+  std::fwrite(pcm, 1, bytes, g_wav);
+  g_wav_bytes += uint32_t(bytes);
+  // Keep the size fields current so the file is a valid WAV even if the process is killed before
+  // WavClose (as the headless test harness does).
+  auto put = [&](long at, uint32_t v) {
+    std::fseek(g_wav, at, SEEK_SET);
+    uint8_t b[4] = {uint8_t(v), uint8_t(v >> 8), uint8_t(v >> 16), uint8_t(v >> 24)};
+    std::fwrite(b, 1, 4, g_wav);
+  };
+  put(4, 36 + g_wav_bytes);
+  put(40, g_wav_bytes);
+  std::fseek(g_wav, 0, SEEK_END);
+}
+void WavClose() {
+  std::lock_guard<std::mutex> lock(g_wav_mutex);
+  if (!g_wav) return;
+  auto patch = [&](long at, uint32_t v) {
+    std::fseek(g_wav, at, SEEK_SET);
+    uint8_t b[4] = {uint8_t(v), uint8_t(v >> 8), uint8_t(v >> 16), uint8_t(v >> 24)};
+    std::fwrite(b, 1, 4, g_wav);
+  };
+  patch(4, 36 + g_wav_bytes);
+  patch(40, g_wav_bytes);
+  std::fclose(g_wav);
+  g_wav = nullptr;
+}
+
+int Rms(const int16_t* s, int n) {
+  if (n <= 0) return 0;
+  double sum = 0.0;
+  for (int i = 0; i < n; ++i) sum += double(s[i]) * s[i];
+  return int(std::sqrt(sum / n));
+}
+
+// --- IMA ADPCM --------------------------------------------------------------------------------
+// Each 20 ms frame is an independent block so a lost UDP packet costs only that frame: a verbatim
+// first sample + step index, then one 4-bit code per remaining sample (~4x smaller than raw PCM,
+// so ~64 kbit/s instead of 256). Both ends run this code, so the format needs no negotiation.
+const int kStep[89] = {
+    7,     8,     9,     10,    11,    12,    13,    14,    16,    17,    19,    21,    23,    25,
+    28,    31,    34,    37,    41,    45,    50,    55,    60,    66,    73,    80,    88,    97,
+    107,   118,   130,   143,   157,   173,   190,   209,   230,   253,   279,   307,   337,   371,
+    408,   449,   494,   544,   598,   658,   724,   796,   876,   963,   1060,  1166,  1282,  1411,
+    1552,  1707,  1878,  2066,  2272,  2499,  2749,  3024,  3327,  3660,  4026,  4428,  4871,  5358,
+    5894,  6484,  7132,  7845,  8630,  9493,  10442, 11487, 12635, 13899, 15289, 16818, 18500,
+    20350, 22385, 24623, 27086, 29794, 32767};
+const int kIndexAdj[16] = {-1, -1, -1, -1, 2, 4, 6, 8, -1, -1, -1, -1, 2, 4, 6, 8};
+
+int Clamp(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }
+
+// Encodes n PCM samples into out (at most 4 + n/2 + 1 bytes); returns the byte count.
+size_t AdpcmEncode(const int16_t* pcm, int n, uint8_t* out) {
+  int predictor = pcm[0];
+  int index = 0;
+  out[0] = uint8_t(predictor & 0xFF);
+  out[1] = uint8_t((predictor >> 8) & 0xFF);
+  out[2] = uint8_t(index);
+  out[3] = 0;
+  size_t op = 4;
+  bool high = false;
+  uint8_t cache = 0;
+  for (int i = 1; i < n; ++i) {
+    const int step = kStep[index];
+    int diff = pcm[i] - predictor;
+    int code = 0;
+    if (diff < 0) { code = 8; diff = -diff; }
+    int tmp = step;
+    if (diff >= tmp) { code |= 4; diff -= tmp; }
+    tmp >>= 1;
+    if (diff >= tmp) { code |= 2; diff -= tmp; }
+    tmp >>= 1;
+    if (diff >= tmp) { code |= 1; }
+    int diffq = step >> 3;
+    if (code & 4) diffq += step;
+    if (code & 2) diffq += step >> 1;
+    if (code & 1) diffq += step >> 2;
+    predictor = Clamp(predictor + ((code & 8) ? -diffq : diffq), -32768, 32767);
+    index = Clamp(index + kIndexAdj[code], 0, 88);
+    if (!high) { cache = uint8_t(code & 0x0F); high = true; }
+    else { out[op++] = uint8_t(cache | (code << 4)); high = false; }
+  }
+  if (high) out[op++] = cache;
+  return op;
+}
+
+// Decodes an ADPCM block into pcm (up to max samples); returns the sample count.
+int AdpcmDecode(const uint8_t* in, size_t len, int16_t* pcm, int max) {
+  if (len < 4 || max < 1) return 0;
+  int predictor = int16_t(uint16_t(in[0]) | (uint16_t(in[1]) << 8));
+  int index = Clamp(in[2], 0, 88);
+  int n = 0;
+  pcm[n++] = int16_t(predictor);
+  size_t ip = 4;
+  bool high = false;
+  uint8_t cur = 0;
+  while (n < max && ip < len) {
+    int code;
+    if (!high) { cur = in[ip]; code = cur & 0x0F; high = true; }
+    else { code = (cur >> 4) & 0x0F; high = false; ++ip; }
+    const int step = kStep[index];
+    int diffq = step >> 3;
+    if (code & 4) diffq += step;
+    if (code & 2) diffq += step >> 1;
+    if (code & 1) diffq += step >> 2;
+    predictor = Clamp(predictor + ((code & 8) ? -diffq : diffq), -32768, 32767);
+    index = Clamp(index + kIndexAdj[code], 0, 88);
+    pcm[n++] = int16_t(predictor);
+  }
+  return n;
+}
+
+// Fills `out` (kFrameSamples) with the next capture frame. Returns false when there is nothing to
+// send this tick (no device, or not enough captured audio yet).
+bool NextCaptureFrame(int16_t* out) {
+  if (REXCVAR_GET(voice_test)) {
+    const double step = 2.0 * M_PI * 440.0 / kSampleRate;  // 440 Hz test tone
+    for (int i = 0; i < kFrameSamples; ++i) {
+      out[i] = int16_t(8000.0 * std::sin(g_tone_phase));
+      g_tone_phase += step;
+      if (g_tone_phase > 2.0 * M_PI) g_tone_phase -= 2.0 * M_PI;
+    }
+    return true;
+  }
+  if (!g_capture) return false;
+  if (SDL_GetAudioStreamAvailable(g_capture) < kFrameBytes) return false;
+  return SDL_GetAudioStreamData(g_capture, out, kFrameBytes) == kFrameBytes;
+}
+
+void CaptureLoop() {
+  std::vector<int16_t> frame(kFrameSamples);
+  int64_t last_loud_ns = 0;
+  while (g_run.load()) {
+    bool sent = false;
+    SessionQueryFn query = g_session_query.load();
+    const bool monitor = REXCVAR_GET(voice_monitor);
+    const bool active = monitor || (query ? query() : g_in_session.load());
+    if (active && REXCVAR_GET(voice_chat)) {
+      while (NextCaptureFrame(frame.data())) {
+        const int rms = Rms(frame.data(), kFrameSamples);
+        // Noise gate with a hangover: once speech crosses the threshold, keep sending the real
+        // (quieter) audio for a short while so brief pauses between words do not cut the stream
+        // and leave the far end's buffer to underrun and crackle.
+        if (rms >= REXCVAR_GET(voice_mic_gate)) last_loud_ns = NowNs();
+        const bool talking = NowNs() - last_loud_ns < 300'000'000;  // 300 ms
+        g_local_talking.store(talking);
+        if (talking) {
+          uint8_t encoded[kFrameBytes];  // ADPCM is always smaller than the raw frame
+          const size_t n = AdpcmEncode(frame.data(), kFrameSamples, encoded);
+          if (monitor) {
+            OnIncomingFrame(0, encoded, n);  // play it straight back so you hear yourself
+          } else if (SendFrameFn fn = g_sender.load()) {
+            fn(encoded, n);
+          }
+          sent = true;
+        }
+        if (REXCVAR_GET(voice_test)) break;  // one tone frame per tick
+      }
+    } else {
+      g_local_talking.store(false);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(sent ? 18 : 8));
+  }
+}
+
+}  // namespace
+
+void Start() {
+  bool expected = false;
+  if (!g_started.compare_exchange_strong(expected, true)) return;
+
+  if (REXCVAR_GET(voice_test)) WavOpen();
+
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    REXLOG_WARN("Voice: no audio subsystem ({}); voice chat disabled", SDL_GetError());
+  } else {
+    SDL_AudioSpec spec = FrameSpec();
+    g_playback = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+    if (g_playback) SDL_ResumeAudioStreamDevice(g_playback);
+    else REXLOG_WARN("Voice: no playback device ({})", SDL_GetError());
+    if (!REXCVAR_GET(voice_test)) {
+      g_capture = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_RECORDING, &spec, nullptr, nullptr);
+      if (g_capture) SDL_ResumeAudioStreamDevice(g_capture);
+      else REXLOG_WARN("Voice: no microphone ({}); you will hear others but not be heard", SDL_GetError());
+    }
+  }
+
+  g_run.store(true);
+  g_capture_thread = std::thread(CaptureLoop);
+  REXLOG_INFO("Voice: started ({}, {} Hz, {} ms frames){}", REXCVAR_GET(voice_chat) ? "on" : "off",
+              kSampleRate, kFrameSamples * 1000 / kSampleRate, REXCVAR_GET(voice_test) ? " [TEST]" : "");
+}
+
+void Stop() {
+  if (!g_started.exchange(false)) return;
+  g_run.store(false);
+  if (g_capture_thread.joinable()) g_capture_thread.join();
+  if (g_capture) SDL_DestroyAudioStream(g_capture);
+  if (g_playback) SDL_DestroyAudioStream(g_playback);
+  g_capture = g_playback = nullptr;
+  WavClose();
+}
+
+void SetInSession(bool in_session) { g_in_session.store(in_session); }
+
+void SetSessionQuery(SessionQueryFn query) { g_session_query.store(query); }
+
+void SetSender(SendFrameFn sender) { g_sender.store(sender); }
+
+void OnIncomingFrame(uint32_t from_id, const uint8_t* frame, size_t bytes) {
+  (void)from_id;
+  if (!REXCVAR_GET(voice_chat) || bytes < 4 || bytes > kFrameBytes) return;
+  int16_t pcm[kFrameSamples];
+  const int n = AdpcmDecode(frame, bytes, pcm, kFrameSamples);
+  if (n <= 0) return;
+  const size_t pcm_bytes = size_t(n) * 2;
+  g_last_remote_ns.store(NowNs());
+  if (REXCVAR_GET(voice_test)) WavWrite(reinterpret_cast<const uint8_t*>(pcm), pcm_bytes);
+  if (g_playback) SDL_PutAudioStreamData(g_playback, pcm, int(pcm_bytes));
+}
+
+bool Enabled() { return REXCVAR_GET(voice_chat); }
+bool LocalTalking() { return g_local_talking.load(); }
+bool RemoteTalking() { return NowNs() - g_last_remote_ns.load() < 300'000'000; }
+
+}  // namespace rex::system::voice
