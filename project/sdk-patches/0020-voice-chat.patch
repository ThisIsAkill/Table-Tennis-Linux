--- /dev/null
+++ b/include/rex/system/voice_chat.h
@@ -0,0 +1,54 @@
+// voice_chat.h - headset voice chat for multiplayer, independent of the game's own (disabled)
+// Xbox voice. Captures the microphone with SDL, sends 20 ms PCM frames to the other players in
+// the room through the online client's transport, and plays what the others send.
+//
+// Audio format: 16 kHz, signed 16-bit, mono, 20 ms frames (320 samples). On the wire each frame
+// is an independent IMA ADPCM block (~164 bytes, ~64 kbit/s) so one lost packet costs one frame.
+//
+// Testing without audio hardware: with voice_test=true the capture source is a generated tone
+// instead of the microphone and every frame played is also written to a WAV file, so the whole
+// capture -> transport -> playback path can be checked on a headless machine.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::system::voice {
+
+// 16 kHz, 20 ms frames.
+inline constexpr int kSampleRate = 16000;
+inline constexpr int kFrameSamples = 320;             // 20 ms
+inline constexpr int kFrameBytes = kFrameSamples * 2;  // signed 16-bit mono
+
+// Starts the microphone capture and playback (idempotent). If there is no audio device, or
+// voice_chat is off, it still runs so test mode and the data path work; it just captures/plays
+// nothing real. Call once the online client is up.
+void Start();
+void Stop();
+
+// Gates real capture/playback on being in a multiplayer room. Frames are only captured and sent
+// while in a session. Used as a fallback when no session query is set (see SetSessionQuery).
+void SetInSession(bool in_session);
+
+// The transport registers this; the capture thread calls it each tick to decide whether a match
+// with other players is in progress. When set, it takes precedence over SetInSession so session
+// start/end is detected without the transport having to push it.
+using SessionQueryFn = bool (*)();
+void SetSessionQuery(SessionQueryFn query);
+
+// The transport registers this; the capture thread calls it with a ready 20 ms frame
+// (kFrameBytes) to send to every other player in the match. The transport decides whether that
+// is the online relay or the System Link peers.
+using SendFrameFn = void (*)(const uint8_t* frame, size_t bytes);
+void SetSender(SendFrameFn sender);
+
+// The transport delivers an incoming frame from a room member for playback.
+void OnIncomingFrame(uint32_t from_id, const uint8_t* frame, size_t bytes);
+
+// For the UI: voice_chat on, and whether the local mic or a remote player is currently audible.
+bool Enabled();
+bool LocalTalking();
+bool RemoteTalking();
+
+}  // namespace rex::system::voice
