+uint32_t ParseAddress(const std::string& text) {
+  in_addr addr{};
+  if (inet_pton(AF_INET, text.c_str(), &addr) != 1) return 0;
+  return ntohl(addr.s_addr);
+}
+
+// The source address the host uses for its default route; no packet is sent.
+uint32_t DefaultRouteAddress() {
+  int fd = ::socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0) return 0;
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(9);
+  to.sin_addr.s_addr = htonl(0x08080808);
+  uint32_t result = 0;
+  if (::connect(fd, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+    sockaddr_in local{};
+    socklen_t len = sizeof(local);
+    if (::getsockname(fd, reinterpret_cast<sockaddr*>(&local), &len) == 0) {
+      result = ntohl(local.sin_addr.s_addr);
+    }
+  }
+  rex::net::socket_close(fd);
+  return result;
+}
