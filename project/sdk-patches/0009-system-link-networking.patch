+void EthernetAddress(uint32_t address, uint8_t out[6]) {
+  out[0] = 0x02;  // locally administered, unicast
+  out[1] = 0x54;
+  out[2] = static_cast<uint8_t>(address >> 24);
+  out[3] = static_cast<uint8_t>(address >> 16);
+  out[4] = static_cast<uint8_t>(address >> 8);
+  out[5] = static_cast<uint8_t>(address);
