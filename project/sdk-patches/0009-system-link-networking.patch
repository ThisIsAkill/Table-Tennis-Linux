+  std::thread([qos_guest, targets, probes, event_handle] {
+    auto* result = REX_KERNEL_MEMORY()->TranslateVirtual<XNQOS*>(qos_guest);
+    for (size_t i = 0; i < targets.size(); ++i) {
+      std::vector<uint8_t> data;
+      uint32_t received = 0;
+      int rtt = targets[i] ? qos::Probe(targets[i], probes, &data, &received) : -1;
+      XNQOSINFO& info = result->info[i];
+      info.probes_xmit = uint16_t(std::max(probes, 2u));
+      info.probes_recv = uint16_t(received);
